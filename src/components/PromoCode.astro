---
export interface Props {
  code: string | null;
}
const { code } = Astro.props;
---
{code && (
  <div class="promo-container">
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="var(--color-text-muted)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="promo-icon"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"></path><line x1="7" y1="7" x2="7.01" y2="7"></line></svg>
    <code class="promo-code tabular-nums" title={code}>{code}</code>
    <button type="button" class="promo-copy" data-code={code} aria-label={`复制优惠码 ${code}`}>
      <span class="copy-text">复制</span>
    </button>
  </div>
)}

<style>
  .promo-container {
    display: inline-flex;
    align-items: center;
    background-color: #081226;
    border: 1px solid var(--color-border);
    border-radius: 9999px;
    padding: 3px 3px 3px 10px;
    font-size: 12px;
    gap: 6px;
    max-width: 100%;
  }
  .promo-icon {
    flex-shrink: 0;
  }
  .promo-code {
    font-family: var(--font-mono);
    color: var(--color-primary);
    font-weight: 700;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    max-width: 80px;
  }
  .promo-copy {
    background: var(--color-primary);
    color: #0E1E3A;
    border: none;
    border-radius: 9999px;
    padding: 4px 10px;
    font-size: 11px;
    font-weight: 800;
    cursor: pointer;
    transition: background-color var(--transition-fast), color var(--transition-fast);
    flex-shrink: 0;
  }
  .promo-copy:hover {
    background: var(--color-primary-dark);
    color: #0E1E3A;
  }
  .promo-copy.copied {
    background: #10b981;
    color: #ffffff;
  }
</style>

<script>
  document.querySelectorAll('.promo-copy').forEach(btn => {
    btn.addEventListener('click', async () => {
      const code = btn.getAttribute('data-code');
      if (!code) return;
      try {
        await navigator.clipboard.writeText(code);
        const textSpan = btn.querySelector('.copy-text');
        if (textSpan) {
          const original = textSpan.textContent;
          textSpan.textContent = '已复制';
          btn.classList.add('copied');
          setTimeout(() => {
            if (textSpan.textContent === '已复制') {
              textSpan.textContent = original;
              btn.classList.remove('copied');
            }
          }, 2000);
        }
      } catch (err) {
        console.error('Failed to copy', err);
      }
    });
  });
</script>
