---
---
<div class="provider-filter">
  <div class="filter-command-bar">
    <div class="search-box">
      <svg class="search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
      <input type="text" id="filterSearch" placeholder="搜索机场名称..." aria-label="搜索机场" />
    </div>
    
    <div class="divider"></div>
    
    <div class="filter-controls">
      <select id="filterPrice" class="filter-select" aria-label="价格门槛">
        <option value="all">价格门槛 (全部)</option>
        <option value="15">≤ ¥15</option>
        <option value="20">≤ ¥20</option>
        <option value="25">≤ ¥25</option>
        <option value="25+">¥25+</option>
      </select>
      
      <select id="filterLine" class="filter-select" aria-label="专线类型">
        <option value="all">专线类型 (全部)</option>
        <option value="IPLC">IPLC</option>
        <option value="IEPL">IEPL</option>
        <option value="BGP">BGP</option>
      </select>
      
      <div class="filter-toggles">
        <label class="toggle-label"><input type="checkbox" id="filterNoExpiry" /> <span>包含不限时</span></label>
        <label class="toggle-label"><input type="checkbox" id="filterStreaming" /> <span>解锁流媒体</span></label>
        <label class="toggle-label"><input type="checkbox" id="filterAI" /> <span>解锁 AI</span></label>
      </div>
      
      <button class="btn-primary" id="startFilterBtn">
        开始筛选
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="btn-icon"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
      </button>
    </div>
  </div>
</div>

<script>
  const searchInput = document.getElementById('filterSearch') as HTMLInputElement;
  const priceSelect = document.getElementById('filterPrice') as HTMLSelectElement;
  const lineSelect = document.getElementById('filterLine') as HTMLSelectElement;
  const noExpiryCheck = document.getElementById('filterNoExpiry') as HTMLInputElement;
  const streamingCheck = document.getElementById('filterStreaming') as HTMLInputElement;
  const aiCheck = document.getElementById('filterAI') as HTMLInputElement;
  const filterBtn = document.getElementById('startFilterBtn') as HTMLButtonElement;
  
  const applyFilters = () => {
    const searchVal = searchInput.value.toLowerCase();
    const priceVal = priceSelect.value;
    const lineVal = lineSelect.value;
    const noExpiry = noExpiryCheck.checked;
    const streaming = streamingCheck.checked;
    const ai = aiCheck.checked;
    
    const cards = document.querySelectorAll('.provider-card');
    cards.forEach(c => {
      const el = c as HTMLElement;
      const name = el.getAttribute('data-name') || '';
      const cPrice = parseInt(el.getAttribute('data-price') || '999');
      const cLines = el.getAttribute('data-lines') || '';
      const cNoExp = el.getAttribute('data-no-expiry') === 'yes';
      const cStream = el.getAttribute('data-streaming') === 'yes';
      const cAI = el.getAttribute('data-ai') === 'yes';
      
      let match = true;
      if (searchVal && !name.includes(searchVal)) match = false;
      if (priceVal !== 'all') {
        if (priceVal === '25+' && cPrice < 25) match = false;
        else if (priceVal !== '25+' && cPrice > parseInt(priceVal)) match = false;
      }
      if (lineVal !== 'all' && !cLines.includes(lineVal)) match = false;
      if (noExpiry && !cNoExp) match = false;
      if (streaming && !cStream) match = false;
      if (ai && !cAI) match = false;
      
      el.style.display = match ? 'flex' : 'none';
    });
  };

  [searchInput, priceSelect, lineSelect, noExpiryCheck, streamingCheck, aiCheck].forEach(el => {
    el.addEventListener('change', applyFilters);
    if (el === searchInput) {
      el.addEventListener('input', applyFilters);
    }
  });
  
  filterBtn.addEventListener('click', () => {
    applyFilters();
    document.getElementById('ranking-grid')?.scrollIntoView({ behavior: 'smooth' });
  });
</script>

<style>
  .provider-filter {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
    padding: var(--spacing-3) var(--spacing-4);
    margin-bottom: var(--spacing-10);
  }
  .filter-command-bar {
    display: flex;
    align-items: center;
    gap: var(--spacing-4);
    flex-wrap: wrap;
  }
  .search-box {
    display: flex;
    align-items: center;
    gap: var(--spacing-2);
    flex: 1;
    min-width: 200px;
  }
  .search-icon {
    width: 20px;
    height: 20px;
    color: var(--color-text-muted);
  }
  .search-box input {
    border: none;
    outline: none;
    width: 100%;
    font-size: var(--text-base);
    color: var(--color-text-main);
    background: transparent;
  }
  .search-box input::placeholder {
    color: var(--color-text-muted);
  }
  .divider {
    width: 1px;
    height: 32px;
    background: var(--color-border);
  }
  .filter-controls {
    display: flex;
    align-items: center;
    gap: var(--spacing-4);
    flex-wrap: wrap;
  }
  .filter-select {
    padding: 8px 12px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    font-size: 14px;
    color: var(--color-text-main);
    background-color: var(--color-base);
    cursor: pointer;
    outline: none;
  }
  .filter-select:hover {
    border-color: var(--color-border-hover);
  }
  .filter-toggles {
    display: flex;
    align-items: center;
    gap: var(--spacing-4);
  }
  .toggle-label {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 14px;
    color: var(--color-text-secondary);
    cursor: pointer;
  }
  .btn-primary {
    background: linear-gradient(135deg, var(--color-primary), #3b82f6);
    color: #0E1E3A;
    box-shadow: 0 4px 15px rgba(79, 70, 229, 0.3);
    border: none;
    padding: 8px 20px;
    border-radius: 9999px;
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    font-weight: 700;
    cursor: pointer;
    transition: all var(--transition-fast);
  }
  .btn-primary:hover {
    box-shadow: 0 6px 20px rgba(79, 70, 229, 0.4);
    transform: translateY(-1px);
  }
  .btn-icon {
    width: 16px;
    height: 16px;
  }
  
  @media (max-width: 900px) {
    .filter-command-bar {
      flex-direction: column;
      align-items: stretch;
    }
    .divider {
      width: 100%;
      height: 1px;
    }
    .filter-controls {
      justify-content: space-between;
    }
  }
</style>
