---
export interface Props {
  name: string;
  logo: string | null;
  size?: 'sm' | 'md' | 'lg';
}
const { name, logo, size = 'md' } = Astro.props;

const fallbackChar = name ? name.charAt(0).toUpperCase() : '?';

const sizeMap = {
  sm: '32px',
  md: '48px',
  lg: '64px'
};
const dimension = sizeMap[size];
---
<div class={`provider-logo logo-${size}`}>
  {logo ? (
    <img src={logo} alt={`${name} Logo`} loading="lazy" />
  ) : (
    <div class="fallback-logo" aria-label={`${name} Logo`}>
      <span aria-hidden="true">{fallbackChar}</span>
    </div>
  )}
</div>

<style define:vars={{ dimension }}>
  .provider-logo {
    width: var(--dimension);
    height: var(--dimension);
    border-radius: var(--radius-sm);
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    flex-shrink: 0;
  }
  .provider-logo img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center;
    padding: var(--spacing-1);
  }
  .fallback-logo {
    width: 100%;
    height: 100%;
    background: #081226;
    color: var(--color-primary);
    font-weight: var(--font-weight-bold);
    font-size: calc(var(--dimension) * 0.45);
    display: flex;
    align-items: center;
    justify-content: center;
  }
</style>
