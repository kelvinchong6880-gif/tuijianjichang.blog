---
import type { Plan } from '../data/schema';

export interface Props {
  plans: Plan[];
}

const { plans } = Astro.props;

function renderClaim(claim: boolean | null) {
  if (claim === true) return '<span class="status-yes">支持</span>';
  if (claim === false) return '<span class="status-no">不支持</span>';
  return '<span class="status-null">资料未说明</span>';
}
---
<div class="table-container">
  <table class="plan-table">
    <thead>
      <tr>
        <th class="col-name">套餐名称</th>
        <th class="col-price">价格</th>
        <th class="col-billing">计费周期</th>
        <th class="col-traffic">流量</th>
        <th class="col-line">线路</th>
        <th class="col-stream">流媒体</th>
        <th class="col-ai">AI</th>
      </tr>
    </thead>
    <tbody>
      {plans.map(plan => (
        <tr>
          <td class="col-name"><strong>{plan.name}</strong></td>
          <td class="col-price tabular-nums">{plan.priceConflict ? <span class="status-null" title={plan.sourceNotes}>正文价格冲突待核实</span> : `¥${plan.price}`}</td>
          <td class="col-billing" set:html={plan.paymentCycleConflict ? '<span class="status-null" style="color:var(--color-warning);">付款周期与实际扣款待核实</span>' : (({ 'Monthly': '月付', 'Quarterly': '季付', 'Yearly': '年付', 'One-Time': '一次性', 'Other': '其他' } as Record<string, string>)[plan.billingType] || '其他')}></td>
          <td class="col-traffic tabular-nums">{plan.trafficDisplay}</td>
          <td class="col-line">{plan.lineType || '未说明'}</td>
          <td class="col-stream" set:html={renderClaim(plan.streaming)} />
          <td class="col-ai" set:html={renderClaim(plan.ai)} />
        </tr>
      ))}
    </tbody>
  </table>
</div>

<style>
  .table-container {
    overflow-x: auto;
    margin: var(--spacing-4) 0 var(--spacing-8) 0;
    border: 1px solid rgba(0,0,0,0.06);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    box-shadow: 0 4px 6px -1px rgba(0,0,0,0.02);
  }
  .plan-table {
    width: 100%;
    border-collapse: separate;
    border-spacing: 0;
    min-width: 700px;
  }
  .plan-table th, .plan-table td {
    padding: 14px 16px;
    text-align: left;
    border-bottom: 1px solid rgba(0,0,0,0.04);
    font-size: 14px;
    line-height: 1.5;
    color: var(--color-text-main);
    vertical-align: middle;
    height: auto;
  }
  .plan-table th {
    background-color: var(--color-surface);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    font-size: 12px;
    color: var(--color-text-muted);
    border-bottom: 1px solid rgba(0,0,0,0.08);
  }
  .plan-table tr:hover td {
    background-color: rgba(0,0,0,0.01);
  }
  .plan-table tr:last-child td {
    border-bottom: none;
  }
  .col-price {
    font-weight: 600;
  }
  :global(.status-yes) { color: var(--color-primary); font-weight: 600; }
  :global(.status-no) { color: var(--color-text-muted); }
  :global(.status-null) { color: var(--color-text-muted); font-size: 0.9em; }
  
  @media (max-width: 768px) {
    .plan-table th:first-child,
    .plan-table td:first-child {
      position: sticky;
      left: 0;
      background-color: var(--color-surface);
      border-right: 1px solid rgba(0,0,0,0.06);
      z-index: 10;
    }
    .plan-table th:first-child {
      background-color: var(--color-surface);
    }
    .plan-table tr:hover td:first-child {
      background-color: #fbfcfe;
    }
  }
</style>
