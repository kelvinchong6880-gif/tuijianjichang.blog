<p class="sr-only" aria-live="polite" id="copy-status"></p>

<script>
  // 全站唯一的“复制优惠码”脚本：所有 .promo-copy 按钮共用
  const status = document.getElementById('copy-status');
  document.addEventListener('click', async (event) => {
    const btn = (event.target as HTMLElement).closest<HTMLButtonElement>('.promo-copy');
    const code = btn?.dataset.code;
    if (!btn || !code) return;
    const label = btn.querySelector('.copy-text') ?? btn;
    if (btn.classList.contains('copied')) return;
    try {
      await navigator.clipboard.writeText(code);
    } catch {
      // 剪贴板不可用时，选中优惠码文本方便手动复制
      const codeEl = btn.parentElement?.querySelector('code');
      if (codeEl) {
        const range = document.createRange();
        range.selectNodeContents(codeEl);
        const sel = window.getSelection();
        sel?.removeAllRanges();
        sel?.addRange(range);
      }
    }
    const original = label.textContent;
    label.textContent = '已复制';
    btn.classList.add('copied');
    if (status) status.textContent = `已复制优惠码 ${code}`;
    window.setTimeout(() => {
      label.textContent = original;
      btn.classList.remove('copied');
    }, 2000);
  });
</script>

<style>
  .site-footer {
    background: var(--color-surface);
    border-top: 1px solid var(--color-border);
    padding-top: var(--spacing-16);
    margin-top: var(--spacing-24);
  }
  .footer-inner {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr;
    gap: var(--spacing-8);
    margin-bottom: var(--spacing-12);
  }
  .brand-col {
    max-width: 400px;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: var(--spacing-3);
    font-weight: var(--font-weight-bold);
    font-size: var(--text-base);
    color: var(--color-text-main);
    margin-bottom: var(--spacing-4);
  }
  .brand-col p {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    line-height: var(--line-height-normal);
  }
  .footer-col h4 {
    font-size: var(--text-sm);
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-main);
    margin-bottom: var(--spacing-4);
  }
  .links {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-3);
  }
  .links a {
    color: var(--color-text-secondary);
    font-size: var(--text-sm);
    transition: color var(--transition-fast);
  }
  .links a:hover {
    color: var(--color-primary);
  }
  .footer-bottom {
    border-top: 1px solid var(--color-border);
    padding: var(--spacing-6) 0;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  @media (max-width: 768px) {
    .footer-inner {
      grid-template-columns: 1fr;
      gap: var(--spacing-8);
    }
    .footer-bottom {
      flex-direction: column;
      text-align: center;
      gap: var(--spacing-4);
    }
  }

  .friends-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-4);
    align-items: center;
    padding-bottom: var(--spacing-6);
    font-size: var(--text-sm);
  }
  .friends-title {
    color: var(--color-text-main);
    font-weight: var(--font-weight-semibold);
  }
  .friends-links a {
