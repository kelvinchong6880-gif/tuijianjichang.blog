---
export interface Props {
  providerCount: number;
  planCount: number;
  pickCount: number;
  lastVerified: string;
}
const { providerCount, planCount, pickCount, lastVerified } = Astro.props;
---
<div class="data-summary">
  <div class="summary-item">
    <span class="value">{providerCount}</span>
    <span class="label">收录机场</span>
  </div>
  <div class="divider"></div>
  <div class="summary-item">
    <span class="value">{planCount}</span>
    <span class="label">套餐资料</span>
  </div>
  <div class="divider"></div>
  <div class="summary-item">
    <span class="value">20</span>
    <span class="label">品牌 Logo</span>
  </div>
  <div class="divider"></div>
  <div class="summary-item">
    <span class="value date">{lastVerified}</span>
    <span class="label">资料持续整理</span>
  </div>
</div>

<style>
  .data-summary {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-4);
    background: var(--color-surface);
    padding: var(--spacing-3) var(--spacing-6);
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-border);
    box-shadow: var(--shadow-sm);
    flex-wrap: wrap;
    margin-bottom: var(--spacing-8);
  }
  .divider {
    width: 1px;
    height: 32px;
    background: var(--color-border);
  }
  .summary-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }
  .value {
    font-size: var(--text-xl);
    font-weight: var(--font-weight-bold);
    color: var(--color-text-main);
    font-variant-numeric: tabular-nums;
    line-height: 1;
    margin-bottom: 4px;
  }
  .label {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }
  .value.date {
    font-size: var(--text-sm);
    font-weight: var(--font-weight-medium);
    margin-bottom: 6px;
  }
  @media (max-width: 600px) {
    .data-summary {
      width: 100%;
      justify-content: space-between;
      padding: var(--spacing-4);
    }
    .divider {
      display: none;
    }
    .summary-item {
      width: calc(50% - var(--spacing-2));
      margin-bottom: var(--spacing-2);
    }
  }
</style>
