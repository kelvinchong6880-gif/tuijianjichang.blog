---
export interface Props {
  providerCount: number;
  planCount: number;
  pickCount: number;
  lastVerified: string;
}
const { providerCount, planCount, pickCount, lastVerified } = Astro.props;
---
<div class="data-summary">
  <div class="summary-item">
    <span class="value">{providerCount}</span>
    <span class="label">收录机场</span>
  </div>
  <div class="summary-item">
    <span class="value">{planCount}</span>
    <span class="label">套餐资料</span>
  </div>
  <div class="summary-item">
    <span class="value">{pickCount}</span>
    <span class="label">编辑精选</span>
  </div>
  <div class="summary-item verification">
    <span class="label">Last Verified</span>
    <span class="value date">{lastVerified}</span>
  </div>
</div>

<style>
  .data-summary {
    display: flex;
    gap: var(--spacing-6);
    background: var(--color-surface);
    padding: var(--spacing-4);
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
    margin-bottom: var(--spacing-6);
    flex-wrap: wrap;
  }
  .summary-item {
    display: flex;
    flex-direction: column;
  }
  .value {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--color-text-main);
    font-variant-numeric: tabular-nums;
  }
  .label {
    font-size: 0.8rem;
    color: var(--color-text-muted);
    text-transform: uppercase;
  }
  .verification {
    margin-left: auto;
    text-align: right;
  }
  .value.date {
    font-size: 1rem;
    margin-top: 4px;
  }
  @media (max-width: 600px) {
    .verification { margin-left: 0; text-align: left; width: 100%; margin-top: var(--spacing-2); }
  }
</style>
