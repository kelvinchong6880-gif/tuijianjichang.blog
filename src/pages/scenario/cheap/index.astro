---
import BaseHead from '../../../components/BaseHead.astro';
import SiteHeader from '../../../components/SiteHeader.astro';
import SiteFooter from '../../../components/SiteFooter.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import AffiliateDisclosure from '../../../components/AffiliateDisclosure.astro';
import { providers } from '../../../data/providers';
import '../../../styles/global.css';

const title = "便宜机场推荐 - 低月付门槛与低月均价套餐数据库筛选";
const description = "低价格门槛机场筛选工具。基于真实套餐数据，分别对比已确认的月付套餐（如 ¥15/月以内）与年付折合低月均价的候选套餐，帮助预算有限的用户清晰了解实际首付门槛与流量规则。";

interface CheapPlan {
  providerName: string;
  providerSlug: string;
  planName: string;
  price: number;
  traffic: number | null;
  trafficDisplay: string;
  reason?: string;
  originalPrice?: number;
}

const monthlyPlans: CheapPlan[] = [];
const yearlyPlans: CheapPlan[] = [];
const conflictPlans: CheapPlan[] = [];

providers.forEach(p => {
  p.plans.forEach(plan => {
    if (plan.currency !== 'CNY') return;

    if (plan.paymentCycleConflict || plan.priceConflict) {
      if (plan.price <= 25) {
        conflictPlans.push({
          providerName: p.name,
          providerSlug: p.slug,
          planName: plan.name,
          price: plan.price,
          traffic: plan.traffic,
          trafficDisplay: plan.trafficDisplay,
          reason: plan.paymentCycleConflict ? '付款条件有歧义，实际购买周期待核实。' : '价格与官方其他宣传资料存在冲突。'
        });
      }
      return;
    }

    if (plan.billingType === 'Monthly' && plan.price <= 20) {
      monthlyPlans.push({
        providerName: p.name,
        providerSlug: p.slug,
        planName: plan.name,
        price: plan.price,
        traffic: plan.traffic,
        trafficDisplay: plan.trafficDisplay
      });
    }

    if (plan.billingType === 'Yearly') {
      const monthlyAvg = plan.price / 12;
      if (monthlyAvg <= 15) {
        yearlyPlans.push({
          providerName: p.name,
          providerSlug: p.slug,
          planName: plan.name,
          price: monthlyAvg, // store average for sorting
          originalPrice: plan.price, // store total for display
          traffic: plan.traffic,
          trafficDisplay: plan.trafficDisplay
        });
      }
    }
  });
});

monthlyPlans.sort((a, b) => a.price - b.price);
yearlyPlans.sort((a, b) => a.price - b.price);
---

<html lang="zh-CN">
  <head>
    <BaseHead title={title} description={description} canonicalPath="/scenario/cheap/" />
  </head>
  <body>
    <SiteHeader />
    <main class="container">
      <Breadcrumbs paths={[
        { label: '机场选购场景', url: '/scenario/' },
        { label: '便宜机场推荐', url: '/scenario/cheap/' }
      ]} />
      
      <header class="section-header">
        <h1>便宜机场推荐：低月付与低月均价套餐筛选</h1>
        <p class="intro">
          本页面汇总了数据库中 <strong>入门价格较低</strong> 的具体套餐候选。我们将“真实按月支付的小额套餐”与“需要一次性支付一年的低月均价套餐”严格区分，帮助预算有限的用户看清实际的 <strong>首付款门槛</strong>。
        </p>
      </header>

      <section class="seo-prose">
        <h2>选购说明与 FAQ</h2>
        <div class="faq-list">
          <div class="faq-item">
            <h3>1. 月付低价 vs 年付低月均价？</h3>
            <p>月付套餐（如 ¥10/月）首月仅需支付 ¥10，试错成本极低。年付套餐（如 ¥98/年，折合 ¥8.17/月）虽然单价看起来更便宜，但您<strong>必须一次性支付全款</strong>，承担服务商未来一年的运营风险。本站将两者分开展示，请根据您的风险承受能力选择。</p>
          </div>
          <div class="faq-item">
            <h3>2. 流量是一次性给还是每月刷新？</h3>
            <p>在年付套餐中，绝大多数机场的流量是 <strong>按期（通常为每 30 天）刷新</strong>，而非将全年流量一次性发放。例如 SOGO 的 ¥98 小包，标注为 60GB 每30天刷新。极少数为一次性不限时流量，请在购买前仔细确认官方规则。</p>
          </div>
        </div>
      </section>

      <section class="section">
        <h2>一、已确认月付候选（¥20/月及以内）</h2>
        <p>以下套餐已确认可以按单月周期购买。价格及付款周期待核实的套餐已被剔除，实际候选 {monthlyPlans.length} 个。</p>
        
        <div class="table-container">
          <table class="data-table">
            <thead>
              <tr>
                <th>品牌与套餐</th>
                <th>实际月付</th>
                <th>套餐流量</th>
                <th>详情入口</th>
              </tr>
            </thead>
            <tbody>
              {monthlyPlans.length > 0 ? monthlyPlans.map(plan => (
                <tr>
                  <td><strong>{plan.providerName}</strong> - {plan.planName}</td>
                  <td><span style="color:var(--color-primary); font-weight:bold;">¥{plan.price}/月</span></td>
                  <td>{plan.trafficDisplay}</td>
                  <td><a href={`/airport/${plan.providerSlug}/`} class="btn btn-small">查看资料</a></td>
                </tr>
              )) : <tr><td colspan="4" style="text-align:center;">暂无符合条件的套餐</td></tr>}
            </tbody>
          </table>
        </div>
      </section>

      <section class="section">
        <h2>二、年付低月均价候选（折合 ¥15/月及以内）</h2>
        <p>以下套餐单价极低，但<strong>必须一次性支付一年总额</strong>。请仔细评估长期预付风险，实际候选 {yearlyPlans.length} 个。</p>
        
        <div class="table-container">
          <table class="data-table">
            <thead>
              <tr>
                <th>品牌与套餐</th>
                <th>年付总额 (需一次支付)</th>
                <th>折合月均价</th>
                <th>每期流量说明</th>
                <th>详情入口</th>
              </tr>
            </thead>
            <tbody>
              {yearlyPlans.length > 0 ? yearlyPlans.map(plan => (
                <tr>
                  <td><strong>{plan.providerName}</strong> - {plan.planName}</td>
                  <td>¥{plan.originalPrice}</td>
                  <td>约 ¥{plan.price.toFixed(2)}/月</td>
                  <td>{plan.trafficDisplay}</td>
                  <td><a href={`/airport/${plan.providerSlug}/`} class="btn btn-small">查看资料</a></td>
                </tr>
              )) : <tr><td colspan="5" style="text-align:center;">暂无符合条件的套餐</td></tr>}
            </tbody>
          </table>
        </div>
      </section>

      {conflictPlans.length > 0 && (
        <section class="section">
          <h2>三、标价或付款条件待核实</h2>
          <p>以下套餐表面标价虽然很低，但由于官方附带了隐藏的购买门槛（例如必须季付），或与其余文本存在冲突，已被本站移出确认清单。在取得明确结算证据前，请谨慎对待其字面低价：</p>
          <div class="table-container">
            <table class="data-table" style="background-color: var(--color-surface); opacity: 0.9;">
              <thead>
                <tr>
                  <th>品牌与套餐</th>
                  <th>字面标价</th>
                  <th>冲突或核实原因</th>
                </tr>
              </thead>
              <tbody>
                {conflictPlans.map(plan => (
                  <tr>
                    <td><strong>{plan.providerName}</strong> - {plan.planName}</td>
                    <td>¥{plan.price}</td>
                    <td style="color: var(--color-warning);">{plan.reason}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>
      )}

      <div style="margin-top: var(--spacing-8); display: flex; gap: var(--spacing-4);">
        <a href="/scenario/value/" class="btn btn-outline">👉 去看 ¥/GB 性价比统计</a>
        <a href="/recommend/" class="btn btn-outline">👉 查看编辑推荐候选</a>
      </div>

      
      <section class="cta-section" style="margin-bottom: 2rem; background: var(--color-surface); padding: 1.5rem; border-radius: var(--radius-md); border: 1px solid var(--color-border); text-align: center;">
        <h2 style="font-size: var(--text-lg); margin-bottom: 0.5rem; margin-top: 0;">不知道怎么选？</h2>
        <p style="color: var(--color-text-muted); margin-bottom: 1rem;">看看经过编辑筛选的综合表现最佳机场。</p>
        <a href="/recommend/" class="btn btn-primary">查看编辑精选：机场推荐榜单</a>
      </section>

      <AffiliateDisclosure />
    </main>
    <SiteFooter />
  </body>
</html>

<style>
  .intro {
    font-size: var(--text-lg);
    color: var(--color-text-secondary);
    margin-bottom: var(--spacing-6);
    line-height: 1.7;
  }
  .table-container {
    margin: var(--spacing-4) 0 var(--spacing-8) 0;
    overflow-x: auto;
  }
  .data-table {
    border-collapse: collapse;
    width: 100%;
    min-width: 600px;
  }
  .data-table th, .data-table td {
    border: 1px solid var(--color-border);
    padding: var(--spacing-3);
    text-align: left;
  }
  .data-table th {
    background-color: var(--color-surface);
    font-weight: var(--font-weight-bold);
  }
  .faq-list {
    gap: var(--spacing-6);
    margin: var(--spacing-6) 0;
    flex-direction: column;
    display: flex;
  }
  .faq-item h3 {
    font-size: 1.1rem;
    font-weight: var(--font-weight-bold);
    margin-bottom: var(--spacing-2);
    color: var(--color-text-main);
  }
  .faq-item p {
    color: var(--color-text-secondary);
    line-height: 1.7;
    margin: 0;
  }
  .btn-small {
    padding: 4px 8px;
    font-size: 0.8rem;
  }
  .btn-outline {
    background: transparent;
    border: 1px solid var(--color-primary);
    color: var(--color-primary);
  }
  .btn-outline:hover {
    background: var(--color-primary);
    color: white;
  }
</style>
