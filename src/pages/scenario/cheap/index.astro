---
import BaseHead from '../../../components/BaseHead.astro';
import SiteHeader from '../../../components/SiteHeader.astro';
import SiteFooter from '../../../components/SiteFooter.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import ScenarioMatrix from '../../../components/ScenarioMatrix.astro';
import DataProvenance from '../../../components/DataProvenance.astro';
import AffiliateDisclosure from '../../../components/AffiliateDisclosure.astro';
import { providers } from '../../../data/providers';
import '../../../styles/global.css';

const title = "便宜机场推荐 - 低月付门槛机场数据库筛选";
const description = "低月付门槛机场筛选工具。筛选出起步价格低于 ¥20/月的候选机场，适合预算有限或优先比较价格门槛的用户参考。";

// Group 1: <= ¥15
const group1 = providers.filter(p => p.entryPrice <= 15).sort((a, b) => a.entryPrice - b.entryPrice);
// Group 2: <= ¥20 (and > 15)
const group2 = providers.filter(p => p.entryPrice > 15 && p.entryPrice <= 20).sort((a, b) => a.entryPrice - b.entryPrice);
---

<html lang="zh-CN">
  <head>
    <BaseHead title={title} description={description} canonicalPath="/scenario/cheap/" />
  </head>
  <body>
    <SiteHeader />
    <main class="container">
      <Breadcrumbs paths={[
        { label: '机场选购场景', url: '/scenario/' },
        { label: '便宜机场推荐', url: '/scenario/cheap/' }
      ]} />
      
      <header class="section-header">
        <h1>便宜机场推荐 / 低月付门槛候选</h1>
        <p class="intro">
          本页面汇总了数据库中 <strong>入门月付价格（Entry Price）较低</strong> 的机场候选。适合预算有限、作为备用机场，或优先比较价格门槛的用户。<br/>
          请注意：低月付门槛往往对应较少的流量或基础线路，请根据实际需求进一步查看具体套餐参数。
        </p>
      </header>

      <AffiliateDisclosure />

      <section class="section">
        <h2>低至 ¥15 / 月门槛</h2>
        <p>入门价格在 15 元及以下的机场候选（共 {group1.length} 家）：</p>
        <ScenarioMatrix providers={group1} showPrice={true} showTraffic={true} showLine={false} showNoExpiry={false} showAI={false} showStreaming={false} />
      </section>

      <section class="section">
        <h2>¥15 - ¥20 / 月门槛</h2>
        <p>入门价格在 15 至 20 元区间的机场候选（共 {group2.length} 家）：</p>
        <ScenarioMatrix providers={group2} showPrice={true} showTraffic={true} showLine={false} showNoExpiry={false} showAI={false} showStreaming={false} />
      </section>

      <section class="section prose">
        <h2>筛选说明与限制</h2>
        <h3>入选标准 (Decision Criteria)</h3>
        <ul>
          <li><strong>条件</strong>：基于官方列出的月付或折算月付最低门槛套餐（entryPrice）&le; 20。</li>
          <li><strong>排除</strong>：一次性不限时套餐（如 100G/一次性）即使总价低于 20 元，也不计入此处的“低月付门槛”比较中，因为它们属于不同的计费逻辑，请前往<a href="/scenario/no-expiry/">不限时套餐场景</a>查看。</li>
        </ul>

        <h3>适合谁 (Who This Fits)</h3>
        <p>预算有限的学生党、极低频度的跨境网络使用者、需要低成本保留一个防失联备用机场的用户。</p>

        <h3>不适合谁 (Who This Does Not Fit)</h3>
        <p>追求极致稳定性、晚高峰 4K 秒开体验、需要全天候重度下载的重度用户。一分钱一分货是客观规律，如果对速度和稳定性要求极高，请综合参考其他场景参数。</p>
      </section>

      <section class="related-section">
        <h2>相关决策指南</h2>
        <div class="related-links">
          <a href="/compare/how-to-choose-plans/">如何科学选择机场套餐？</a>
          <a href="/scenario/backup/">备用机场怎么选？</a>
        </div>
      </section>

      <DataProvenance />
    </main>
    <SiteFooter />
  </body>
</html>

<style>
  .section-header {
    margin: var(--spacing-8) 0;
  }
  .section-header h1 {
    font-size: 2.2rem;
    margin-bottom: var(--spacing-4);
  }
  .intro {
    font-size: 1.1rem;
    color: var(--color-text-muted);
    line-height: 1.6;
  }
  .section {
    margin: var(--spacing-8) 0;
  }
  .prose h2 { margin-top: var(--spacing-8); }
  .prose h3 { margin-top: var(--spacing-6); }
  .related-section {
    margin: var(--spacing-12) 0;
    padding-top: var(--spacing-8);
    border-top: 1px solid var(--color-border);
  }
  .related-links {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-3);
  }
  .related-links a {
    color: var(--color-primary);
    text-decoration: none;
    font-size: 1.1rem;
  }
</style>
