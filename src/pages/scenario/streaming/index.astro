---
import BaseHead from '../../../components/BaseHead.astro';
import SiteHeader from '../../../components/SiteHeader.astro';
import SiteFooter from '../../../components/SiteFooter.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import AffiliateDisclosure from '../../../components/AffiliateDisclosure.astro';
import { providers } from '../../../data/providers';
import '../../../styles/global.css';

const title = "提供流媒体解锁声明的机场候选";
const description = "流媒体解锁机场候选。收录官方声明支持解锁 Netflix、Disney+ 等海外流媒体的机场，购买前建议实测目标地区和平台。";

const streamProviders = providers.filter(p => p.streamingClaim);
---

<html lang="zh-CN">
  <head>
    <BaseHead title={title} description={description} canonicalPath="/scenario/streaming/" />
  </head>
  <body>
    <SiteHeader />
    <main class="container">
      <Breadcrumbs paths={[
        { label: '机场选购场景', url: '/scenario/' },
        { label: '流媒体解锁', url: '/scenario/streaming/' }
      ]} />
      
      <header class="section-header">
        <h1>声明提供流媒体解锁的机场候选</h1>
        <p class="intro">
          本页面汇总了在其官方资料或常见问题中声明“提供流媒体解锁服务”的机场。若要获得稳定的观影体验，单凭商家的笼统声明是远远不够的。
        </p>
      </header>

      <section class="seo-prose">
        <div class="warning-alert">
          <strong>⚠️ 购买前须知：没有通用的解锁神话</strong>
          <p>
            1. <strong>不凭空捏造名词</strong>：如果商家资料未具体说明，本站绝不凭空为其添加“全地区解锁”、“原生IP”或“DNS解锁”等技术标签。<br/>
            2. <strong>细分地区与平台</strong>：笼统声明支持流媒体，绝不等于支持“所有地区的 Netflix”和“所有的 Disney+”。部分节点可能仅解锁特定区域的内容库。<br/>
            3. <strong>自己动手验证</strong>：不要仅凭节点上带个国家的国旗图标，就认为它能看该国流媒体。购买前应实际验证目标平台与目标地区是否可播放。
          </p>
        </div>
      </section>

      <section class="section">
        <h2>包含流媒体解锁声明的品牌 (共 {streamProviders.length} 家)</h2>
        <div class="table-container">
          <table class="data-table">
            <thead>
              <tr>
                <th>品牌名称</th>
                <th>官方解锁声明</th>
                <th>未经验证项</th>
                <th>详情入口</th>
              </tr>
            </thead>
            <tbody>
              {streamProviders.map(p => (
                <tr>
                  <td><strong>{p.name}</strong></td>
                  <td><span style="color: #16a34a;">包含流媒体声明</span></td>
                  <td><span style="color: var(--color-text-muted);">具体地区与实际平台需实测</span></td>
                  <td><a href={`/airport/${p.slug}/`} class="btn btn-small">查看资料</a></td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
      
      <div style="margin-top: var(--spacing-8);">
        <a href="/compare/how-to-choose-plans/" class="btn btn-outline">👉 查看购买前检查清单</a>
      </div>
      <AffiliateDisclosure />
    </main>
    <SiteFooter />
  </body>
</html>

<style>
  .intro { font-size: var(--text-lg); color: var(--color-text-secondary); margin-bottom: var(--spacing-6); line-height: 1.7; }
  .table-container { margin: var(--spacing-4) 0 var(--spacing-8) 0; overflow-x: auto; }
  .data-table { border-collapse: collapse; width: 100%; min-width: 600px; }
  .data-table th, .data-table td { border: 1px solid var(--color-border); padding: var(--spacing-3); text-align: left; }
  .data-table th { background-color: var(--color-surface); font-weight: var(--font-weight-bold); }
  .warning-alert { background-color: rgba(234, 179, 8, 0.1); border-left: 4px solid #eab308; padding: var(--spacing-4); margin: var(--spacing-6) 0; }
  .warning-alert strong { color: #b45309; }
  .warning-alert p { margin: var(--spacing-2) 0 0 0; color: var(--color-text-main); line-height: 1.6; }
  .btn-small { padding: 4px 8px; font-size: 0.8rem; }
  .btn-outline { background: transparent; border: 1px solid var(--color-primary); color: var(--color-primary); }
</style>
