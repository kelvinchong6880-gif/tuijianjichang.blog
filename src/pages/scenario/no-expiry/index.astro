---
import BaseHead from '../../../components/BaseHead.astro';
import SiteHeader from '../../../components/SiteHeader.astro';
import SiteFooter from '../../../components/SiteFooter.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import ScenarioMatrix from '../../../components/ScenarioMatrix.astro';
import DataProvenance from '../../../components/DataProvenance.astro';
import AffiliateDisclosure from '../../../components/AffiliateDisclosure.astro';
import { providers } from '../../../data/providers';
import '../../../styles/global.css';

const title = "不限时机场套餐候选 - 流量永久有效";
const description = "不限时机场套餐集合。收录官方明确提供“永久有效流量”或“无时间限制”套餐的机场候选，适合网络使用频率极不规律的用户。";

const noExpiryProviders = providers.filter(p => p.hasNoExpiry);
---

<html lang="zh-CN">
  <head>
    <BaseHead title={title} description={description} canonicalPath="/scenario/no-expiry/" />
  </head>
  <body>
    <SiteHeader />
    <main class="container">
      <Breadcrumbs paths={[
        { label: '机场选购场景', url: '/scenario/' },
        { label: '不限时机场套餐', url: '/scenario/no-expiry/' }
      ]} />
      
      <header class="section-header">
        <h1>不限时机场套餐 / 流量永久有效候选</h1>
        <p class="intro">
          本页面收录了数据库中官方资料明确提供 <strong>“流量永久有效”</strong> 或 <strong>“无到期时间限制”</strong>（No-Fixed-Expiry）套餐的机场。<br/>
          这种计费模式（一次性付费买断流量，用完即止）特别适合极低频或使用量极不规律的用户。
        </p>
      </header>

      <AffiliateDisclosure />

      <section class="section">
        <h2>提供不限时套餐的机场候选</h2>
        <p>经过 Source 资料核实，以下 {noExpiryProviders.length} 家机场提供了无固定到期时间的流量包套餐：</p>
        <ScenarioMatrix providers={noExpiryProviders} showNoExpiry={true} showPrice={false} showTraffic={false} />
      </section>

      <section class="section prose">
        <h2>重要筛选规则与限制 (Important Limitations)</h2>
        
        <div class="warning-alert">
          <strong>⚠️ 关键概念澄清：不限时 ≠ 无限流量</strong>
          <p>
            “不限时”仅仅代表<strong>时间维度</strong>上没有像月付那样按月清零的硬性过期时间，它<strong>绝对不等于</strong>无限可用流量（Unlimited Traffic）。<br/>
            例如：购买一个 100GB 的不限时套餐，无论你用了一周还是一年，一旦消耗完这 100GB，套餐即宣告结束，需要重新购买。
          </p>
        </div>

        <h3>适合谁 (Who This Fits)</h3>
        <p>偶尔需要查阅海外资料、不固定看外网视频、不希望每个月都被强制月供绑定、或者纯粹想要保留一个永远不过期“备胎”防失联的用户。</p>

        <h3>不适合谁 (Who This Does Not Fit)</h3>
        <p>长期重度追剧、每日需要进行高强度外网视频会议或文件下载的用户。对于大流量使用者而言，不限时套餐的每 GB 单价通常远高于常规的月付套餐，极度不划算。</p>
      </section>

      <section class="related-section">
        <h2>相关决策指南</h2>
        <div class="related-links">
          <a href="/compare/monthly-vs-no-expiry/">月付套餐与不限时套餐怎么选？</a>
          <a href="/scenario/backup/">如何组合不限时套餐作为备用方案？</a>
        </div>
      </section>

      <DataProvenance />
    </main>
    <SiteFooter />
  </body>
</html>

<style>
  .section-header { margin: var(--spacing-8) 0; }
  .section-header h1 { font-size: 2.2rem; margin-bottom: var(--spacing-4); }
  .intro { font-size: 1.1rem; color: var(--color-text-muted); line-height: 1.6; }
  .section { margin: var(--spacing-8) 0; }
  .prose h2 { margin-top: var(--spacing-8); }
  .prose h3 { margin-top: var(--spacing-6); }
  .warning-alert {
    background-color: rgba(220, 38, 38, 0.1);
    border-left: 4px solid #dc2626;
    padding: var(--spacing-4);
    margin: var(--spacing-4) 0;
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
  }
  .warning-alert strong { display: block; margin-bottom: var(--spacing-2); color: #b91c1c; }
  .warning-alert p { margin: 0; }
  .related-section {
    margin: var(--spacing-12) 0;
    padding-top: var(--spacing-8);
    border-top: 1px solid var(--color-border);
  }
  .related-links { display: flex; flex-direction: column; gap: var(--spacing-3); }
  .related-links a { color: var(--color-primary); text-decoration: none; font-size: 1.1rem; }
</style>
