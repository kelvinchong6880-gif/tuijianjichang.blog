---
import BaseHead from '../../../components/BaseHead.astro';
import SiteHeader from '../../../components/SiteHeader.astro';
import SiteFooter from '../../../components/SiteFooter.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import AffiliateDisclosure from '../../../components/AffiliateDisclosure.astro';
import { providers } from '../../../data/providers';
import '../../../styles/global.css';

const title = "备用机场推荐 - 低首付与不限时候选";
const description = "备用机场该怎么选？基于真实套餐数据，推荐首付成本极低的月付套餐或不限时按量计费套餐，作为主机场故障时的应急备胎。";

interface BackupPlan {
  providerName: string;
  providerSlug: string;
  planName: string;
  price: number;
  trafficDisplay: string;
  validity: string;
  type: 'Low-Monthly' | 'No-Expiry';
}

const backupPlans: BackupPlan[] = [];

providers.forEach(p => {
  p.plans.forEach(plan => {
    if (plan.priceConflict || plan.paymentCycleConflict) return;

    if (plan.billingType === 'Monthly' && plan.price <= 15) {
      backupPlans.push({
        providerName: p.name,
        providerSlug: p.slug,
        planName: plan.name,
        price: plan.price,
        trafficDisplay: plan.trafficDisplay,
        validity: plan.validity,
        type: 'Low-Monthly'
      });
    }

    const valStr = plan.validity ? plan.validity.toLowerCase() : '';
    const isNoExpiry = valStr.includes('不限时') || valStr.includes('无到期') || valStr.includes('永久') || valStr.includes('permanent') || valStr.includes('用完即止');
    if (isNoExpiry && !plan.priceConflict && !plan.paymentCycleConflict) {
      backupPlans.push({
        providerName: p.name,
        providerSlug: p.slug,
        planName: plan.name,
        price: plan.price,
        trafficDisplay: plan.trafficDisplay,
        validity: plan.validity,
        type: 'No-Expiry'
      });
    }
  });
});

const lowMonthly = backupPlans.filter(p => p.type === 'Low-Monthly').sort((a, b) => a.price - b.price);
const noExpiry = backupPlans.filter(p => p.type === 'No-Expiry').sort((a, b) => a.price - b.price);
---

<html lang="zh-CN">
  <head>
    <BaseHead title={title} description={description} canonicalPath="/scenario/backup/" />
  </head>
  <body>
    <SiteHeader />
    <main class="container">
      <Breadcrumbs paths={[
        { label: '机场选购场景', url: '/scenario/' },
        { label: '备用机场', url: '/scenario/backup/' }
      ]} />
      
      <header class="section-header">
        <h1>备用机场套餐候选：低首付与不限时方案</h1>
        <p class="intro">
          任何机场都存在节点被封锁或服务器故障的风险。拥有一个“备用机场”能在关键时刻保证网络畅通。由于备用网络使用频率极低，我们建议从 <strong>首付极低的月付套餐</strong> 或 <strong>无固定到期时间的不限时套餐</strong> 中进行选择。
        </p>
      </header>

      <section class="seo-prose">
        <h2>备用机场购买前检查清单</h2>
        <ul>
          <li><strong>上游依赖检查：</strong>尽量选择与您的主机场 <strong>上游不同</strong> 的服务商。如果两者依赖同一个上游，极有可能在封锁期同时发生故障。如果未获取到上游信息，请视为“未知上游”。</li>
          <li><strong>连接可用性：</strong>备用机场的意义在于应急。购买后请务必先测试能否实际连接。</li>
          <li><strong>余额与有效期：</strong>对于不限时套餐，请定期检查其账户是否依然处于激活状态，避免服务商单方面清理长期未活跃账号。</li>
        </ul>
      </section>

      <section class="section">
        <h2>一、低首付月付候选 (¥15及以内)</h2>
        <p>月付套餐首付成本极低，适合短期应急使用。共 {lowMonthly.length} 个候选：</p>
        <div class="table-container">
          <table class="data-table">
            <thead>
              <tr>
                <th>品牌与套餐</th>
                <th>月付价格</th>
                <th>标称流量 (每月刷新)</th>
                <th>详情入口</th>
              </tr>
            </thead>
            <tbody>
              {lowMonthly.length > 0 ? lowMonthly.map(plan => (
                <tr>
                  <td><strong>{plan.providerName}</strong> - {plan.planName}</td>
                  <td>¥{plan.price}</td>
                  <td>{plan.trafficDisplay}</td>
                  <td><a href={`/airport/${plan.providerSlug}/`} class="btn btn-small">查看资料</a></td>
                </tr>
              )) : <tr><td colspan="4" style="text-align:center;">暂无符合条件的套餐</td></tr>}
            </tbody>
          </table>
        </div>
      </section>

      <section class="section">
        <h2>二、不限时按量计费候选</h2>
        <p>一次性买断一定流量，无明确到期时间，非常适合作为长期的安静备胎。共 {noExpiry.length} 个候选：</p>
        <div class="table-container">
          <table class="data-table">
            <thead>
              <tr>
                <th>品牌与套餐</th>
                <th>一次性价格</th>
                <th>总流量</th>
                <th>有效期规则</th>
                <th>详情入口</th>
              </tr>
            </thead>
            <tbody>
              {noExpiry.length > 0 ? noExpiry.map(plan => (
                <tr>
                  <td><strong>{plan.providerName}</strong> - {plan.planName}</td>
                  <td>¥{plan.price}</td>
                  <td>{plan.trafficDisplay}</td>
                  <td>{plan.validity}</td>
                  <td><a href={`/airport/${plan.providerSlug}/`} class="btn btn-small">查看资料</a></td>
                </tr>
              )) : <tr><td colspan="5" style="text-align:center;">暂无符合条件的套餐</td></tr>}
            </tbody>
          </table>
        </div>
      </section>

      <div style="margin-top: var(--spacing-8); display: flex; gap: var(--spacing-4);">
        <a href="/scenario/cheap/" class="btn btn-outline">👉 去看便宜月付候选</a>
        <a href="/compare/monthly-vs-no-expiry/" class="btn btn-outline">👉 月付与不限时对比指南</a>
      </div>
      <AffiliateDisclosure />
    </main>
    <SiteFooter />
  </body>
</html>

<style>
  .intro { font-size: var(--text-lg); color: var(--color-text-secondary); margin-bottom: var(--spacing-6); line-height: 1.7; }
  .table-container { margin: var(--spacing-4) 0 var(--spacing-8) 0; overflow-x: auto; }
  .data-table { border-collapse: collapse; width: 100%; min-width: 600px; }
  .data-table th, .data-table td { border: 1px solid var(--color-border); padding: var(--spacing-3); text-align: left; }
  .data-table th { background-color: var(--color-surface); font-weight: var(--font-weight-bold); }
  .btn-small { padding: 4px 8px; font-size: 0.8rem; }
  .btn-outline { background: transparent; border: 1px solid var(--color-primary); color: var(--color-primary); }
  .btn-outline:hover { background: var(--color-primary); color: white; }
  .seo-prose ul { margin-left: var(--spacing-6); }
  .seo-prose li { margin-bottom: var(--spacing-2); line-height: 1.6; }
</style>
