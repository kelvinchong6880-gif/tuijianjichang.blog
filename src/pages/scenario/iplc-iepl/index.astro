---
import BaseHead from '../../../components/BaseHead.astro';
import SiteHeader from '../../../components/SiteHeader.astro';
import SiteFooter from '../../../components/SiteFooter.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import AffiliateDisclosure from '../../../components/AffiliateDisclosure.astro';
import { providers } from '../../../data/providers';
import '../../../styles/global.css';

const title = "IPLC / IEPL 专线机场候选";
const description = "专线机场套餐筛选。收集官方资料中明确标注采用 IPLC、IEPL 或 BGP 跨境专线的机场品牌。";

const iplcProviders = providers.filter(p => p.lineClaims && p.lineClaims.some(l => l.includes('IPLC') || l.includes('IEPL')));
---

<html lang="zh-CN">
  <head>
    <BaseHead title={title} description={description} canonicalPath="/scenario/iplc-iepl/" />
  </head>
  <body>
    <SiteHeader />
    <main class="container">
      <Breadcrumbs paths={[
        { label: '机场选购场景', url: '/scenario/' },
        { label: 'IPLC / IEPL 专线', url: '/scenario/iplc-iepl/' }
      ]} />
      
      <header class="section-header">
        <h1>声明包含 IPLC / IEPL 专线的候选机场</h1>
        <p class="intro">
          本页面汇总了官方套餐资料中明确标注了“IPLC”或“IEPL”跨境专线的机场品牌。请注意区分：这是商家的 <strong>线路标签声明</strong>，并不等同于其实际验证网络表现。
        </p>
      </header>

      <section class="section">
        <h2>专线标签服务商 (共 {iplcProviders.length} 家)</h2>
        <div class="table-container">
          <table class="data-table">
            <thead>
              <tr>
                <th>品牌名称</th>
                <th>官方线路宣称</th>
                <th>性能实测验证</th>
                <th>详情入口</th>
              </tr>
            </thead>
            <tbody>
              {iplcProviders.map(p => (
                <tr>
                  <td><strong>{p.name}</strong></td>
                  <td>{p.lineClaims.join(', ')}</td>
                  <td><span style="color: var(--color-text-muted);">需用户实地测速</span></td>
                  <td><a href={`/airport/${p.slug}/`} class="btn btn-small">查看资料</a></td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
      
      <div style="margin-top: var(--spacing-8);">
        <a href="/compare/iplc-vs-iepl/" class="btn btn-outline">👉 IPLC、IEPL 与公网到底有什么区别？</a>
      </div>
      <AffiliateDisclosure />
    </main>
    <SiteFooter />
  </body>
</html>

<style>
  .intro { font-size: var(--text-lg); color: var(--color-text-secondary); margin-bottom: var(--spacing-6); line-height: 1.7; }
  .table-container { margin: var(--spacing-4) 0 var(--spacing-8) 0; overflow-x: auto; }
  .data-table { border-collapse: collapse; width: 100%; min-width: 600px; }
  .data-table th, .data-table td { border: 1px solid var(--color-border); padding: var(--spacing-3); text-align: left; }
  .data-table th { background-color: var(--color-surface); font-weight: var(--font-weight-bold); }
  .btn-small { padding: 4px 8px; font-size: 0.8rem; }
  .btn-outline { background: transparent; border: 1px solid var(--color-primary); color: var(--color-primary); }
</style>
