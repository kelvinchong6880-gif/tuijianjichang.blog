---
import { providers } from '../../data/providers';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import BaseHead from '../../components/BaseHead.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Top8ComparisonMatrix from '../../components/Top8ComparisonMatrix.astro';
import AffiliateDisclosure from '../../components/AffiliateDisclosure.astro';
import ProviderLogo from '../../components/ProviderLogo.astro';
import PromoCode from '../../components/PromoCode.astro';
import Button from '../../components/Button.astro';
import '../../styles/global.css';
import { faqSchema, trafficRange } from '../../data/analysis';
import { UPDATED_ISO, UPDATED_LABEL, UPDATED_MONTH, UPDATED_MONTH_SHORT, EDITOR, SITE_NAME, SITE_URL } from '../../data/site';

const totalCount = providers.length;
const title = `2026机场排行榜：Top 8 机场评测与对比（${UPDATED_MONTH_SHORT}更新）`;
const description = `${UPDATED_MONTH}机场排行榜：从${totalCount}家机场中选出 Top 8，逐一对比月付价格、年付折扣、IPLC/IEPL 线路、流量与不限时套餐，附优惠码与选购 FAQ。第一名 SOGO云 月付¥25起150GB全IEPL专线。`;

const top8 = providers.filter(p => p.editorialPick).sort((a, b) => a.editorialRank! - b.editorialRank!);

const editorialReviews: Record<string, { strength: string, limitation: string, fit: string, unfit: string }> = {
  'sogo-yun': {
    strength: '月付套餐全部走 IEPL 专线，¥25/月 150GB 起；官方标称单节点峰值 2.5Gbps、所有节点 1 倍率、晚高峰不降速，原生 IP 解锁 Netflix、Disney+、ChatGPT。节点覆盖香港×20、日本×10、新加坡×10、美国×10 等 10 多个地区。月付支持年付 8 折、两年 7 折、三年 6 折，另有 4 款不限时流量包。',
    limitation: '¥25 的月付起步价不是全站最低（无忧 ¥19、极连云 ¥18 更便宜）；不限时流量包不参与长期付费折扣。',
    fit: '想“一次选对、不再折腾”的用户：日常 150GB 选基础版 ¥25/月，追剧选优选版 ¥45/月 350GB，全家共用选顶配版 ¥150/月 1050GB；轻度用户可选 ¥98/年 的 60GB 小包。',
    unfit: '只追求最低价、每月预算 ¥20 以下的用户，可以看无忧或跨界。'
  },
  'weifeng': {
    strength: '全 IPLC 专线、不限速、不限设备。乘风 ¥27/月 就有 200GB，破风 ¥57/月 500GB，在同价位里流量给得比较足；另有清风 ¥137/年（每月 100GB）和两款不限时包（270GB ¥200、570GB ¥370）。',
    limitation: '官网没有单独写明流媒体与 AI 解锁情况；月付起步价 ¥27 在 Top 8 里偏高。',
    fit: '每月用 150–500GB、看重专线稳定性的用户；优惠码 weifeng90。',
    unfit: '每月只用几十 GB 的轻度用户，选年付小包更划算的机场会更省。'
  },
  'feimaoyun': {
    strength: '全 IPLC 专线、单节点最高 2.5Gbps、原生 IP 解锁 Netflix 与 ChatGPT。学生版 ¥84/年（每月 50GB，折合约 ¥7/月）是 Top 8 里最便宜的年付入门款；星耀版 ¥25/月 150GB。节点覆盖香港×20、台湾×10、日本×10、新加坡×10、美国×10、韩国×3 等。',
    limitation: '不限时只有一款 1TB/¥680 的大包，门槛较高；周期套餐的长期折扣需年付才能享受。',
    fit: '学生党和轻度用户（¥84/年），或每月 150–600GB 的常规用户；优惠码 flycat888。',
    unfit: '想买小额不限时备用流量的用户。'
  },
  'wuyou': {
    strength: '舒心链接 ¥19/月 100GB，是 Top 8 里月付门槛最低的；全 IPLC 专线、1 倍率，官网写明支持 ChatGPT、Gemini 与 4K Netflix/Disney+。另有 MINI 年付 ¥79/年 和 100GB ¥108、300GB ¥298 两款不限时包。',
    limitation: '年付 MINI 每月只有 40GB；最高档 1TB 需 ¥117/月。',
    fit: '预算每月 ¥20 左右、主要用 AI 和看视频的学生与上班族；优惠码 wuyou。',
    unfit: '每月需要 1TB 以上流量的重度用户。'
  },
  'firefly': {
    strength: '全 IPLC 专线、不限速、不限设备。Firefly Lite ¥25/月 150GB，Plus ¥45/月 300GB，Nova ¥150/月 1TB，套餐梯度清晰；年付版 ¥96/年（每月 60GB），还有 100GB ¥100 的不限时包。',
    limitation: '官网没有写明流媒体与 AI 解锁情况，如果这是主要需求，建议先问客服。',
    fit: '想要专线、套餐简单好选的常规用户；优惠码 firefly。',
    unfit: '对 Netflix、ChatGPT 解锁有硬性要求、又不想自己测试的用户。'
  },
  'kuajieyun': {
    strength: '轻云 Lite ¥20/月 120GB 起，全 IPLC、1 倍率、不限速；无界 1.8TB 只要 ¥130/月（约 ¥0.07/GB），是 Top 8 里大流量单价最低的。年付 8 折、两年 7 折、三年 6 折，且优惠码可以叠加。官网写明支持 ChatGPT、Gemini、Claude 和主流流媒体。',
    limitation: '没有不限时流量包。',
    fit: '流量大、想压低每 GB 成本的重度用户和家庭；优惠码 kuajie。',
    unfit: '只想买一次性备用流量的用户。'
  },
  'shanyue': {
    strength: '闪动 ¥24/月 150GB，全 IPLC 专线、所有节点 1 倍率、晚高峰不限速，原生 IP 解锁流媒体、ChatGPT 与 TikTok。年付版 ¥96/年（每月 60GB），最高跃迁 1TB ¥134/月。',
    limitation: '没有不限时流量包；套餐只有 5 档，选择相对少。',
    fit: '每月 150–300GB、需要 TikTok 或 ChatGPT 的用户；优惠码 shanyue。',
    unfit: '每月流量超过 1TB 的用户。'
  },
  'lingmao': {
    strength: '月付 Small ¥25/月 150GB，全 IPLC 专线、最高 1000Mbps 带宽、不限客户端，原生 IP 解锁 Netflix、ChatGPT、Gemini、TikTok，客服全天在线。年付 Small ¥195/年（每月 150GB，折合约 ¥16/月）性价比不错。',
    limitation: '最高档只有 300GB/月，没有不限时套餐。',
    fit: '每月 150–300GB、愿意年付换更低单价的用户；优惠码 lingmao。',
    unfit: '每月需要 500GB 以上流量的重度用户。'
  }
};

const faqItems = [
  { q: '2026 年机场推荐哪家？', a: `综合线路、价格和流量，${UPDATED_MONTH}本站排名第一的是 SOGO云：月付 ¥25 起 150GB，全 IEPL 专线、晚高峰不降速。预算更低可以选无忧（¥19/月 100GB）或跨界（¥20/月 120GB）；只想年付的轻度用户可以选飞猫云学生版（¥84/年）。` },
  { q: '我应该怎么选出适合自己的套餐？', a: '第一看预算，确定每月愿意花多少钱；第二看流量，偶尔查资料、用 AI 每月 50GB 以内就够，天天看视频需要 150GB 以上，追 4K 剧或全家共用要 300–600GB；第三看付款周期，第一次用某家机场建议先买月付，满意后再年付。' },
  { q: '月付和年付有什么区别？“¥8 起”是月付价吗？', a: '不是。很多机场首页写的“¥8 起”是年付总价平摊到每月的价格，需要一次付清一年费用，而且年付小包的流量通常只有 40–60GB/月。真正按月付款的套餐一般在 ¥18–¥27 之间。选购时请分清“月付实际价格”和“年付折合月价”。' },
  { q: 'IPLC 和 IEPL 专线机场有什么好处？', a: 'IPLC/IEPL 是跨境专线，不经过公网拥堵的国际出口，晚高峰掉速、断流的概率比普通中转线路小，延迟也更稳定。本榜 Top 8 全部是 IPLC 或 IEPL 专线机场。' },
  { q: '为什么 SOGO云 排第一？', a: 'SOGO云 的月付套餐全部是 IEPL 专线，¥25 就有 150GB，节点覆盖 10 多个地区，并且有年付 8 折到三年 6 折的长期折扣和 4 款不限时流量包，能覆盖从轻度到重度的大部分需求。SOGO云 也是本站的合作品牌，我们会通过推广链接获得佣金，但你支付的价格不变。' },
];

const jsonLd = [
  faqSchema(faqItems),
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: title,
    itemListOrder: 'https://schema.org/ItemListOrderAscending',
    numberOfItems: top8.length,
    itemListElement: top8.map((p, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: p.name,
      url: `${SITE_URL}/airport/${p.slug}/`,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: title,
    description,
    inLanguage: 'zh-CN',
    datePublished: '2026-09-15',
    dateModified: UPDATED_ISO,
    author: { '@type': 'Organization', name: EDITOR, url: `${SITE_URL}/methodology/` },
    publisher: { '@type': 'Organization', name: SITE_NAME, url: `${SITE_URL}/` },
    mainEntityOfPage: `${SITE_URL}/recommend/`,
  },
];

---

<html lang="zh-CN">
  <head>
    <BaseHead title={title} description={description} canonicalPath="/recommend/" jsonLd={jsonLd} ogType="article" />
  </head>
  <body>
    <SiteHeader />
    <main id="main" class="container">
      <Breadcrumbs paths={[{ label: '机场排行榜', url: '/recommend/' }]} />
      
      <header class="page-header">
        <div class="eyebrow">机场排行榜 · 更新于 <time datetime={UPDATED_ISO}>{UPDATED_LABEL}</time></div>
        <h1>{title}</h1>
        <p class="lead">这份排行榜是 <a href="/">机场推荐</a> 的详细版：我们从 {totalCount} 家机场里挑出 8 家 IPLC/IEPL 专线机场，按线路质量、月付价格、流量性价比、年付折扣和不限时套餐综合排序。每家都写清楚了适合谁、不适合谁，直接对照自己的预算和用量选就行。</p>
        <ol class="top-list">
          {top8.map((p) => (
            <li><a href={`/airport/${p.slug}/`}><strong>{p.name}</strong></a> — 月付 ¥{p.entryPrice} 起，{p.lineClaims.join('/')} 专线{p.promoCode ? `，优惠码 ${p.promoCode}` : ''}</li>
          ))}
        </ol>
      </header>

      <nav class="toc-section" aria-label="本页目录">
        <h2>本页目录</h2>
        <ul>
          <li><a href="#quick-compare">1. Top 8 快速参数对比</a></li>
          <li><a href="#editorial-picks">2. 逐家评测与推荐理由</a></li>
          <li><a href="#scenario-selection">3. 按需继续筛选机场</a></li>
          <li><a href="#faq">4. 机场排行榜常见问题</a></li>
        </ul>
      </nav>

      <section id="quick-compare" class="matrix-section">
        <h2>Top 8 快速参数对比</h2>
        <Top8ComparisonMatrix />
      </section>

      <section id="editorial-picks" class="ranking-rail">
        <h2>Top 8 机场逐家评测</h2>
        <div class="rail-container">
          {top8.map(p => {
            const review = editorialReviews[p.id] || {
              strength: '提供了相对平衡的套餐选择。',
              limitation: '暂无明显的特定短板或长板数据记录。',
              fit: '适合常规网络浏览用户。',
              unfit: '追求极致定制化体验的用户。'
            };
            return (
            <div class={`rail-card ${p.editorialRank && p.editorialRank <= 3 ? 'is-top3' : ''}`}>
              <div class="rail-header">
                <div class="identity">
                  <span class={`rank-number ${p.editorialRank && p.editorialRank <= 3 ? 'rank-number-top' : ''}`}>#0{p.editorialRank}</span>
                  <ProviderLogo name={p.name} logo={p.logo} size="md" />
                  <h3 class="brand-name"><a href={`/airport/${p.slug}/`}>{p.name}</a></h3>
                </div>
              </div>
              
              <div class="rail-body">
                <div class="editorial-analysis">
                  <h4>推荐理由</h4>
                  <p>{review.strength}</p>
                  
                  <h4>需要注意</h4>
                  <p>{review.limitation}</p>

                  <h4>适合谁</h4>
                  <p>{review.fit}</p>
                  
                  <h4>不太适合</h4>
                  <p>{review.unfit}</p>
                </div>
                
                <div class="quick-snapshot">
                  <h4>{p.name} 套餐速览</h4>
                  <div class="snapshot-metrics">
                    <div class="s-metric">
                      <span class="s-value tabular-nums">¥{p.entryPrice}</span>
                      <span class="s-label">月付起步</span>
                    </div>
                    <div class="s-metric">
                      <span class="s-value tabular-nums">{trafficRange(p)}</span>
                      <span class="s-label">每月流量</span>
                    </div>
                  </div>
                  
                  <div class="snapshot-features">
                    <div class="sf-row">
                      <span class="sf-label">线路</span>
                      <span class="sf-val">{p.lineClaims.length ? p.lineClaims.join(', ') : '资料未说明'}</span>
                    </div>
                    <div class="sf-row">
                      <span class="sf-label">流媒体</span>
                      <span class="sf-val">{p.streamingClaim === true ? '支持' : p.streamingClaim === false ? '不支持' : '资料未说明'}</span>
                    </div>
                  </div>
                  
                  {p.promoCode && (
                    <div class="promo-box">
                      <PromoCode code={p.promoCode} />
                    </div>
                  )}
                  
                  <div class="cta-group">
                    <Button variant="secondary" href={`/airport/${p.slug}/`} class="full-w">{p.name}详细评测</Button>
                    {p.affiliateUrl && (
                      <Button variant="primary" href={p.affiliateUrl} target="_blank" rel="nofollow sponsored noopener" class="full-w">访问官网</Button>
                    )}
                  </div>
                </div>
              </div>
            </div>
          )})}
        </div>
      </section>

      <section id="scenario-selection" class="scenario-navigation">
        <h2>按需求继续筛选机场</h2>
        <div class="scenario-grid">
          <a href="/scenario/cheap/" class="scenario-link">便宜机场推荐</a>
          <a href="/scenario/iplc-iepl/" class="scenario-link">IPLC / IEPL 专线机场</a>
          <a href="/scenario/no-expiry/" class="scenario-link">不限时机场</a>
          <a href="/scenario/ai-chatgpt/" class="scenario-link">AI / ChatGPT 机场</a>
          <a href="/scenario/streaming/" class="scenario-link">流媒体解锁机场</a>
          <a href="/scenario/high-traffic/" class="scenario-link">大流量机场</a>
          <a href="/scenario/value/" class="scenario-link" style="border-color: var(--color-primary);">高性价比机场排行</a>
        </div>
      </section>

      <section id="faq" class="faq-section">
        <h2>机场排行榜常见问题</h2>
        <div class="faq-list">
          {faqItems.map((f) => (
            <div class="faq-item">
              <h3>{f.q}</h3>
              <p>{f.a}</p>
            </div>
          ))}
        </div>
      </section>

      <div class="back-to-home">
        <p>想看全部 {totalCount} 家机场？回到 <a href="/">机场推荐首页</a> 按价格、流量和线路筛选。</p>
      </div>

      <div class="ranking-disclaimer">
          <svg aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="disclaimer-icon"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/></svg>
          <div>
            <strong>排名方法：</strong> 本榜按线路类型（IPLC/IEPL 优先）、月付起步价、每 GB 成本、长期付费折扣、不限时套餐和流媒体/AI 解锁情况综合排序，数据来自各机场官网，核对于 {UPDATED_LABEL}。SOGO云 为本站合作品牌。网络体验会受本地运营商影响，第一次购买建议先选月付。
          </div>
        </div>
      
      <AffiliateDisclosure />
    </main>
    <SiteFooter />
  </body>
</html>

<style>
  .page-header {
    margin-bottom: var(--spacing-8);
  }
  .toc-section {
    margin-bottom: 2rem;
    background: var(--color-surface);
    padding: 1.5rem;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
  }
  .toc-section h2 { margin: 0 0 1rem; font-size: var(--text-lg); }
  .toc-section ul { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 1rem; }
  .toc-section a { color: var(--color-primary); font-weight: 500; }
  .back-to-home { margin-top: 2rem; text-align: center; }
  .eyebrow {
    font-size: var(--text-xs);
    font-weight: var(--font-weight-bold);
    color: var(--color-primary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: var(--spacing-2);
  }
  .lead { color: var(--color-text-secondary); line-height: 1.8; margin-bottom: var(--spacing-4); }
  .lead a, .top-list a, .brand-name a { color: var(--color-primary); }
  .top-list { padding-left: 1.4em; color: var(--color-text-secondary); line-height: 1.9; }
  .page-header h1 {
    font-size: var(--text-3xl);
    font-weight: var(--font-weight-bold);
    margin-bottom: var(--spacing-6);
    color: var(--color-text-main);
  }
  .ranking-disclaimer {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    padding: var(--spacing-4);
    border-radius: var(--radius-md);
    color: var(--color-text-secondary);
    line-height: var(--line-height-normal);
    font-size: var(--text-sm);
    display: flex;
    gap: var(--spacing-3);
    align-items: flex-start;
  }
  .disclaimer-icon {
    width: 20px;
    height: 20px;
    color: var(--color-primary);
    flex-shrink: 0;
    margin-top: 2px;
  }
  .matrix-section {
    margin-bottom: var(--spacing-16);
  }
  .matrix-section h2, .ranking-rail h2, .scenario-navigation h2, .faq-section h2 {
    font-size: var(--text-xl);
    margin-bottom: var(--spacing-6);
    color: var(--color-text-main);
  }
  .rail-container {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-8);
    margin-bottom: var(--spacing-16);
  }
  .rail-card {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background-color: var(--color-surface);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    transition: box-shadow var(--transition-fast);
  }
  .rail-card:hover {
    box-shadow: var(--shadow-md);
  }
  .rail-card.is-top3 {
    border-top: 3px solid var(--color-primary);
  }
  .rail-header {
    display: flex;
    align-items: center;
    padding: var(--spacing-4) var(--spacing-6);
    border-bottom: 1px solid var(--color-border);
    background-color: var(--color-base);
  }
  .identity {
    display: flex;
    align-items: center;
    gap: var(--spacing-4);
  }
  .rank-number {
    font-size: var(--text-sm);
    font-weight: var(--font-weight-bold);
    color: var(--color-text-muted);
    background: var(--color-surface);
    padding: 2px 10px;
    border-radius: var(--radius-full);
    border: 1px solid var(--color-border);
  }
  .rank-number-top {
    background: var(--color-primary-soft);
    color: var(--color-primary);
    border-color: transparent;
  }
  .brand-name {
    margin: 0;
    font-size: var(--text-xl);
    font-weight: var(--font-weight-bold);
  }
  .rail-body {
    display: flex;
    flex-wrap: wrap;
    padding: var(--spacing-6);
    gap: var(--spacing-8);
  }
  .editorial-analysis {
    flex: 2;
    min-width: 300px;
  }
  .editorial-analysis h4 {
    margin-top: var(--spacing-5);
    margin-bottom: var(--spacing-2);
    color: var(--color-text-main);
    font-size: var(--text-sm);
    font-weight: var(--font-weight-semibold);
  }
  .editorial-analysis h4:first-child {
    margin-top: 0;
  }
  .editorial-analysis p {
    color: var(--color-text-secondary);
    font-size: var(--text-sm);
    line-height: var(--line-height-normal);
  }
  .quick-snapshot {
