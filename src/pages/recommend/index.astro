---
import { providers } from '../../data/providers';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import BaseHead from '../../components/BaseHead.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Top8ComparisonMatrix from '../../components/Top8ComparisonMatrix.astro';
import AffiliateDisclosure from '../../components/AffiliateDisclosure.astro';
import ProviderLogo from '../../components/ProviderLogo.astro';
import PromoCode from '../../components/PromoCode.astro';
import Button from '../../components/Button.astro';
import '../../styles/global.css';

const totalCount = providers.length;
const title = `2026机场推荐：Top 8 编辑精选与${totalCount}家候选指南`;
const description = `整理${totalCount}家机场的价格、流量与套餐资料。提供2026年Top 8编辑推荐，包含SOGO云等商业主推。按预算、流量和使用需求快速对比，附带避坑FAQ。`;

const top8 = providers.filter(p => p.editorialPick).sort((a, b) => a.editorialRank! - b.editorialRank!);

const editorialReviews: Record<string, { strength: string, limitation: string, fit: string, unfit: string }> = {
  'sogo-yun': {
    strength: '根据官方资料，提供 IPLC/IEPL 线路与 2.5Gbps 标称峰值，且日本/美国线路在第三方历史快照中曾表现出较强带宽。支持按月付（150GB-550GB）与年付小包，具备高度灵活性。',
    limitation: '最高档位（顶配版及不限时大流量版）的价格与流量官方资料存在矛盾，已从系统单价排序中剔除。该历史测试中，香港节点平均下载速度约44–61MB/s；结果仅适用于该次测试条件。',
    fit: '预算在 ¥25/月起（150GB）、¥45/月（350GB）、¥80/月（550GB），且主要需要日区/美区高带宽（如视频、下载）的中重度用户；或仅需年付 ¥98 (60GB/每30天) 的低频长尾用户。',
    unfit: '极度追求极限低价的用户。'
  },
  'feimaoyun': {
    strength: '官方提供了起步价低至 ¥84/年 (折合约 ¥7/月) 的学生版套餐，且标价¥25/月（实际购买周期与扣款待核实）的套餐直接标称为 IPLC 线路，支持流媒体及 AI。提供 ¥680 的不限时大包。',
    limitation: '最低门槛套餐（¥84/年）的月流量仅为 50GB。当前未能找到明确的第三方公开测速报告以支持其全线 IPLC 满载率。',
    fit: '年付预算在 ¥100 以内且月流量需求不高于 50GB 的轻度文字查阅用户，或需要 ¥680 一次性买断 1TB 流量的用户。',
    unfit: '需要长期大流量环境且不愿年付的重度视频用户。'
  },
  'kuajieyun': {
    strength: '提供了 ¥20/月 (120GB) 到 ¥130/月 (1.8TB) 等多档位梯度，均宣称为 IPLC 线路。包含 ¥96/年的小流量备用包（60GB）。',
    limitation: '暂时缺少本站关联的明确第三方测速数据报告以证实其线路的峰值速度。本站未收录其不限时套餐。',
    fit: '希望以 ¥20 起步价获取百 GB 以上流量，且对流媒体和 ChatGPT 有基础需求的用户。',
    unfit: '期望购买按量计费不限时套餐作为备用池的用户。'
  },
  'shanyue': {
    strength: '提供 ¥24/月 档位。官方资料宣称支持流媒体与 AI，并且在常规地区（港新日）保持覆盖。',
    limitation: '本站未收录其不限时套餐，且当前缺少直接的第三方性能测试参考以证实其实际带宽。',
    fit: '预算在 ¥24/月，愿意根据其套餐说明直接按月购买测试其实际网络状况的用户。',
    unfit: '要求本站提供详细第三方历史跑分数据才能做决策的用户。'
  },
  'wuyou': {
    strength: '提供 ¥19/月 起的月付套餐，在低于 ¥20 的价格线上提供了订阅选项，同时包含每年约 ¥120 的年付配置。',
    limitation: '由于本站缺少该品牌晚高峰的具体测速数据及用户数样本，无法确认其长期带宽保障水平。本站未收录其不限时套餐。',
    fit: '月预算严格控制在 ¥20 以下，仅需要满足基础查阅需求的用户。',
    unfit: '高频次下载大文件或在晚高峰重度观看 4K 流媒体的用户。'
  },
  'lingmao': {
    strength: '提供 ¥25/月 基础订阅，以及约 ¥168 的年付选择，宣称为支持流媒体及 AI 的常规配置。',
    limitation: '当前未收录关于其具体线路（如是否含明确专线声明）及可用性的第三方验证材料。',
    fit: '每月可支配 ¥25 左右用于代理，且对冷门节点要求不高的常规用户。',
    unfit: '对线路类型（如强制要求 IEPL）有明确硬性限制或需要实测证明的用户。'
  },
  'firefly': {
    strength: '提供 ¥25/月起步选项，且提供 ¥240/年 (折合 ¥20/月) 的梯度供选择。宣称支持流媒体及 AI。',
    limitation: '在目前的资料池中，未收录第三方实测证明其带宽容量及线路抗拥堵能力。',
    fit: '偏好按月或按季度试用常规海外社媒代理体验的用户。',
    unfit: '对于测速数据缺失容忍度低、要求极客级别自定义的用户。'
  },
  'weifeng': {
    strength: '在 ¥27/月的价位区间提供了月付起步套餐，并提供约 ¥260 的年付方案。',
    limitation: '本站未获得其确切的线路类型声明（IPLC/IEPL 缺失）、倍率说明及网络稳定性跑分，无法提供具体的性能背书。',
    fit: '对价格敏感度适中，愿意自行实测其 ¥27 月付套餐在本地运营商下表现的用户。',
    unfit: '寻找极致低价（¥15以下）或要求本站提供实测背书的用户。'
  }
};

function getTrafficDisplay(p: any) {
  const validPlans = p.plans.filter((x: any) => x.traffic !== null);
  if (validPlans.length === 0) return p.trafficDisplay || '未说明';
  let maxT = Math.max(...validPlans.map((x: any) => x.traffic));
  // if p.trafficDisplay has (已确认) string, just return that
  if (p.trafficDisplay && p.trafficDisplay.includes('已确认')) return p.trafficDisplay;
  return maxT >= 1000 ? `${(maxT/1000).toFixed(1).replace(/\.0$/, '')}TB` : `${maxT}GB`;
}
---

<html lang="zh-CN">
  <head>
    <BaseHead title={title} description={description} canonicalPath="/recommend/" />
  </head>
  <body>
    <SiteHeader />
    <main class="container">
      <Breadcrumbs paths={[{ label: '机场推荐', url: '/recommend/' }]} />
      
      <header class="page-header">
        <div class="eyebrow">推荐榜单</div>
        <h1>{title}</h1>
        </header>

      <section class="toc-section" style="margin-bottom: 2rem; background: var(--color-surface); padding: 1.5rem; border-radius: var(--radius-md); border: 1px solid var(--color-border);">
        <h2 style="margin-top: 0; font-size: var(--text-lg); margin-bottom: 1rem;">快速导航目录</h2>
        <ul style="list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: 1rem;">
          <li><a href="#quick-compare" style="color: var(--color-primary); font-weight: 500; text-decoration: none;">1. Top 8 快速参数对比</a></li>
          <li><a href="#editorial-picks" style="color: var(--color-primary); font-weight: 500; text-decoration: none;">2. 编辑精选详情与推荐理由</a></li>
          <li><a href="#scenario-selection" style="color: var(--color-primary); font-weight: 500; text-decoration: none;">3. 按需继续筛选机场</a></li>
          <li><a href="#faq" style="color: var(--color-primary); font-weight: 500; text-decoration: none;">4. 机场推荐常见问题 (FAQ)</a></li>
        </ul>
      </section>

      <section id="quick-compare" class="matrix-section">
        <h2>Top 8 快速参数对比</h2>
        <Top8ComparisonMatrix />
      </section>

      <section id="editorial-picks" class="ranking-rail">
        <h2>编辑精选详情</h2>
        <div class="rail-container">
          {top8.map(p => {
            const review = editorialReviews[p.id] || {
              strength: '提供了相对平衡的套餐选择。',
              limitation: '暂无明显的特定短板或长板数据记录。',
              fit: '适合常规网络浏览用户。',
              unfit: '追求极致定制化体验的用户。'
            };
            return (
            <div class={`rail-card ${p.editorialRank && p.editorialRank <= 3 ? 'is-top3' : ''}`}>
              <div class="rail-header">
                <div class="identity">
                  <span class={`rank-number ${p.editorialRank && p.editorialRank <= 3 ? 'rank-number-top' : ''}`}>#0{p.editorialRank}</span>
                  <ProviderLogo name={p.name} logo={p.logo} size="md" />
                  <h3 class="brand-name">{p.name}</h3>
                </div>
              </div>
              
              <div class="rail-body">
                <div class="editorial-analysis">
                  <h4>推荐理由与资料支持</h4>
                  <p>{review.strength}</p>
                  
                  <h4>限制与待核实项</h4>
                  <p>{review.limitation}</p>

                  <h4>适合谁</h4>
                  <p>{review.fit}</p>
                  
                  <h4>哪些用户需要谨慎（不适合）</h4>
                  <p>{review.unfit}</p>
                </div>
                
                <div class="quick-snapshot">
                  <h4>套餐快照</h4>
                  <div class="snapshot-metrics">
                    <div class="s-metric">
                      <span class="s-value tabular-nums">¥{p.entryPrice}</span>
                      <span class="s-label">最低起步款</span>
                    </div>
                    <div class="s-metric">
                      <span class="s-value tabular-nums">{getTrafficDisplay(p)}</span>
                      <span class="s-label">流量跨度</span>
                    </div>
                  </div>
                  
                  <div class="snapshot-features">
                    <div class="sf-row">
                      <span class="sf-label">线路声明</span>
                      <span class="sf-val">{p.lineClaims.length ? p.lineClaims.join(', ') : '资料未说明'}</span>
                    </div>
                    <div class="sf-row">
                      <span class="sf-label">流媒体</span>
                      <span class="sf-val">{p.streamingClaim === true ? '支持' : p.streamingClaim === false ? '不支持' : '资料未说明'}</span>
                    </div>
                  </div>
                  
                  {p.promoCode && (
                    <div class="promo-box">
                      <PromoCode code={p.promoCode} />
                    </div>
                  )}
                  
                  <div class="cta-group">
                    <Button variant="secondary" href={`/airport/${p.slug}/`} class="full-w">查看完整品牌数据</Button>
                    {p.affiliateUrl && (
                      <Button variant="primary" href={p.affiliateUrl} target="_blank" rel="nofollow sponsored noopener" class="full-w">访问官网</Button>
                    )}
                  </div>
                </div>
              </div>
            </div>
          )})}
        </div>
      </section>

      <section id="scenario-selection" class="scenario-navigation">
        <h2>按需求继续筛选机场</h2>
        <div class="scenario-grid">
          <a href="/scenario/cheap/" class="scenario-link">便宜机场推荐</a>
          <a href="/scenario/iplc-iepl/" class="scenario-link">IPLC / IEPL 专线机场</a>
          <a href="/scenario/no-expiry/" class="scenario-link">不限时机场</a>
          <a href="/scenario/ai-chatgpt/" class="scenario-link">AI / ChatGPT 机场</a>
          <a href="/scenario/streaming/" class="scenario-link">流媒体解锁机场</a>
          <a href="/scenario/high-traffic/" class="scenario-link">大流量机场</a>
          <a href="/scenario/value/" class="scenario-link" style="border-color: var(--color-primary);">高性价比机场排行</a>
        </div>
      </section>

      <section id="faq" class="faq-section">
        <h2>机场推荐常见问题 (FAQ)</h2>
        <div class="faq-list">
          <div class="faq-item">
            <h3>我应该怎么选出适合自己的套餐？</h3>
            <p>第一看预算，确定你每个月愿意支付多少钱；第二看需求流量，是偶尔查阅资料（50GB以内），还是天天看视频（200GB以上）；第三看付款周期，初次使用切忌直接年付。建议先从低价月付开始试错。</p>
          </div>
          <div class="faq-item">
            <h3>月付和年付的区别是什么？最低标价等于月付价吗？</h3>
            <p>不等于！许多商家会在首页写着“¥8起”，但这往往是指**年付总额平摊下来的月均价**（且要求一次性支付年费）。真正的月付（Monthly）套餐往往价格更高。我们建议您在我们的对比表中，仔细区分“月付实际扣款”与“年付折合月均”，看清楚再下单。</p>
          </div>
          <div class="faq-item">
            <h3>为什么本站把 SOGO云 作为首位主推？</h3>
            <p>SOGO云是本站的商业合作伙伴，我们从其返佣计划中获得维持网站运转的收入。但同时，其 ¥25/150GB 以及 ¥98 年付小包的结构，确实能覆盖很广的用户需求区间；并且其在部分第三方历史测速样本中，展现出了在日美地区的真实带宽潜力。但请注意，本站不对其未来稳定性做任何保证，建议您按月付试用。</p>
          </div>
          <div class="faq-item">
            <h3>官方宣称（如“2.5Gbps”和“全解锁”）和实际测试有区别吗？</h3>
            <p>区别很大。官方宣称代表的是其服务器端口接入的理论上限，或者某个测试瞬间的结果。实际您用起来的速度，取决于您本地宽带运营商、物理距离、晚高峰拥塞程度以及目标网站的限速策略。这也是为什么我们要求读者不要轻信单一的“历史63节点样本”，一切以本地实测为准。</p>
          </div>
        </div>
      </section>

      <div class="back-to-home" style="margin-top: 2rem; text-align: center;">
        <p>需要查阅完整数据源？请前往 <a href="/">完整 {totalCount} 家机场数据库</a> 进行深入筛选。</p>
      </div>

      <div class="ranking-disclaimer">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="disclaimer-icon"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/></svg>
          <div>
            <strong>排名与推荐性质说明：</strong> 本页展示的 8 个候选品牌及其顺序纯属本站编辑的主观选择，并非基于统一测速的冠亚军排名，也不代表纯价格的绝对高低。其中，<strong>SOGO云为本站当前的核心商业主推品牌</strong>（包含推广合作关系）。本站仅基于官方资料、套餐结构及有限第三方公开引用提供信息，不对任何节点的持续可用性作刚性背书。
          </div>
        </div>
      
      <AffiliateDisclosure />
    </main>
    <SiteFooter />
  </body>
</html>

<style>
  .page-header {
    margin-bottom: var(--spacing-8);
  }
  .eyebrow {
    font-size: var(--text-xs);
    font-weight: var(--font-weight-bold);
    color: var(--color-primary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: var(--spacing-2);
  }
  .page-header h1 {
    font-size: var(--text-3xl);
    font-weight: var(--font-weight-bold);
    margin-bottom: var(--spacing-6);
    color: var(--color-text-main);
  }
  .ranking-disclaimer {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    padding: var(--spacing-4);
    border-radius: var(--radius-md);
    color: var(--color-text-secondary);
    line-height: var(--line-height-normal);
    font-size: var(--text-sm);
    display: flex;
    gap: var(--spacing-3);
    align-items: flex-start;
  }
  .disclaimer-icon {
    width: 20px;
    height: 20px;
    color: var(--color-primary);
    flex-shrink: 0;
    margin-top: 2px;
  }
  .matrix-section {
    margin-bottom: var(--spacing-16);
  }
  .matrix-section h2, .ranking-rail h2, .scenario-navigation h2, .faq-section h2 {
    font-size: var(--text-xl);
    margin-bottom: var(--spacing-6);
    color: var(--color-text-main);
  }
  .rail-container {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-8);
    margin-bottom: var(--spacing-16);
  }
  .rail-card {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background-color: var(--color-surface);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    transition: box-shadow var(--transition-fast);
  }
  .rail-card:hover {
    box-shadow: var(--shadow-md);
  }
  .rail-card.is-top3 {
    border-top: 3px solid var(--color-primary);
  }
  .rail-header {
    display: flex;
    align-items: center;
    padding: var(--spacing-4) var(--spacing-6);
    border-bottom: 1px solid var(--color-border);
    background-color: var(--color-base);
  }
  .identity {
    display: flex;
    align-items: center;
    gap: var(--spacing-4);
  }
  .rank-number {
    font-size: var(--text-sm);
    font-weight: var(--font-weight-bold);
    color: var(--color-text-muted);
    background: var(--color-surface);
    padding: 2px 10px;
    border-radius: var(--radius-full);
    border: 1px solid var(--color-border);
  }
  .rank-number-top {
    background: var(--color-primary-soft);
    color: var(--color-primary);
    border-color: transparent;
  }
  .brand-name {
    margin: 0;
    font-size: var(--text-xl);
    font-weight: var(--font-weight-bold);
  }
  .rail-body {
    display: flex;
    flex-wrap: wrap;
    padding: var(--spacing-6);
    gap: var(--spacing-8);
  }
  .editorial-analysis {
    flex: 2;
    min-width: 300px;
  }
  .editorial-analysis h4 {
    margin-top: var(--spacing-5);
    margin-bottom: var(--spacing-2);
    color: var(--color-text-main);
    font-size: var(--text-sm);
    font-weight: var(--font-weight-semibold);
  }
  .editorial-analysis h4:first-child {
    margin-top: 0;
  }
  .editorial-analysis p {
    color: var(--color-text-secondary);
    font-size: var(--text-sm);
    line-height: var(--line-height-normal);
  }
  .quick-snapshot {
    flex: 1;
    min-width: 250px;
    background-color: var(--color-base);
    padding: var(--spacing-6);
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
  }
  .quick-snapshot h4 {
    margin-top: 0;
    margin-bottom: var(--spacing-4);
    font-size: var(--text-sm);
    color: var(--color-text-main);
  }
  .snapshot-metrics {
    display: flex;
    gap: var(--spacing-4);
    margin-bottom: var(--spacing-4);
    padding-bottom: var(--spacing-4);
    border-bottom: 1px solid var(--color-border);
  }
  .s-metric {
    display: flex;
    flex-direction: column;
  }
  .s-value {
    font-size: var(--text-xl);
    font-weight: var(--font-weight-bold);
    color: var(--color-text-main);
  }
  .s-label {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }
  .snapshot-features {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-2);
    margin-bottom: var(--spacing-4);
  }
  .sf-row {
    display: flex;
    justify-content: space-between;
    font-size: var(--text-sm);
  }
  .sf-label {
    color: var(--color-text-muted);
  }
  .sf-val {
    color: var(--color-text-main);
    font-weight: var(--font-weight-medium);
  }
  .promo-box {
    margin-bottom: var(--spacing-4);
  }
  .cta-group {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-3);
  }
  :global(.full-w) {
    width: 100%;
  }
  .scenario-navigation, .faq-section {
    margin-top: var(--spacing-12);
  }
  .scenario-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
