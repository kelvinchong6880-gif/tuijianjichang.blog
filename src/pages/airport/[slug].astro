---
import { providers } from '../../data/providers';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import BaseHead from '../../components/BaseHead.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ProviderSpecs from '../../components/ProviderSpecs.astro';
import PlanTable from '../../components/PlanTable.astro';
import AffiliateDisclosure from '../../components/AffiliateDisclosure.astro';
import DataProvenance from '../../components/DataProvenance.astro';
import SourceRecords from '../../components/SourceRecords.astro';
import RelatedProviders from '../../components/RelatedProviders.astro';
import EvidenceBadge from '../../components/EvidenceBadge.astro';
import ProviderLogo from '../../components/ProviderLogo.astro';
import PromoCode from '../../components/PromoCode.astro';
import Button from '../../components/Button.astro';
import { customContent } from '../../data/customContent';
import BrandReview from '../../components/BrandReview.astro';
import { monthlyPlans, consumerPlans, fmtGB, lineLabel, faqFor, faqSchema } from '../../data/analysis';
import { UPDATED_ISO, UPDATED_LABEL, UPDATED_MONTH, EDITOR, SITE_NAME, SITE_URL } from '../../data/site';
import '../../styles/global.css';

export async function getStaticPaths() {
  return providers.map(provider => ({
    params: { slug: provider.slug },
    props: { provider },
  }));
}

const { provider } = Astro.props;
const custom = customContent[provider.slug] ?? {};
const mon = monthlyPlans(provider);
const startPrice = mon.length ? `¥${mon[0].price}/月起` : `¥${provider.entryPrice}起`;
const title = custom.title ?? `${provider.name}怎么样？2026 ${provider.name}机场评测：套餐价格与优惠码`;
const description = custom.desc ?? `${provider.name}机场评测（${UPDATED_MONTH}更新）：${startPrice}，${consumerPlans(provider).length}个套餐，流量${fmtGB(provider.trafficMin)}–${fmtGB(provider.trafficMax)}，${lineLabel(provider)}线路${provider.hasNoExpiry ? '，有不限时流量包' : ''}${provider.promoCode ? `，优惠码${provider.promoCode}` : ''}。附选购建议、优缺点与同价位对比。`;
const h1Text = custom.h1 ?? `${provider.name}怎么样？${provider.name}机场评测与套餐选购指南`;
const faqs = faqFor(provider);
const jsonLd = [
  faqSchema(faqs),
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: h1Text,
    description,
    inLanguage: 'zh-CN',
    datePublished: '2026-09-15',
    dateModified: UPDATED_ISO,
    author: { '@type': 'Organization', name: EDITOR, url: `${SITE_URL}/methodology/` },
    publisher: { '@type': 'Organization', name: SITE_NAME, url: `${SITE_URL}/` },
    mainEntityOfPage: `${SITE_URL}/airport/${provider.slug}/`,
  },
];
---

<html lang="zh-CN">
  <head>
    <BaseHead title={title} description={description} canonicalPath={`/airport/${provider.slug}/`} jsonLd={jsonLd} ogType="article" />
  </head>
  <body>
    <SiteHeader />
    <main id="main" class="container">
      <Breadcrumbs paths={[
        { label: '机场大全', url: '/airports/' },
        { label: provider.name, url: `/airport/${provider.slug}/` }
      ]} />
      
      <header class="provider-header">
        <div class="provider-identity">
          <ProviderLogo name={provider.name} logo={provider.logo} size="lg" />
          <div class="identity-text">
            <h1>{h1Text}</h1>
            <div class="badges">
              {provider.editorialPick && <span class="badge pick">编辑推荐 #{provider.editorialRank}</span>}
              <EvidenceBadge type="source" label="官网数据" />
              <span class="updated">更新于 <time datetime={UPDATED_ISO}>{UPDATED_LABEL}</time></span>
            </div>
          </div>
        </div>
        
        <div class="header-actions">
          {provider.promoCode && (
            <div class="promo-container">
              <PromoCode code={provider.promoCode} />
            </div>
          )}
          {provider.affiliateUrl && (
            <Button variant="primary" href={provider.affiliateUrl} target="_blank" rel="nofollow sponsored noopener">
              访问官网
            </Button>
          )}
        </div>
      </header>

      <ProviderSpecs provider={provider} />
      
      {custom.intro && (
        <div class="reading-container custom-content-top" set:html={custom.intro} />
      )}

      <section class="section section-plans">
        <h2>{provider.name}套餐价格表（{UPDATED_MONTH}）</h2>
        <PlanTable plans={provider.plans} />
      </section>

      <div class="reading-container">
        {custom.extra && <div class="custom-content-wrapper" set:html={custom.extra} />}
        <BrandReview provider={provider} showIntro={!custom.intro} />

        {provider.affiliateUrl && (
          <div class="bottom-cta">
            <Button variant="primary" href={provider.affiliateUrl} target="_blank" rel="nofollow sponsored noopener" class="btn-large">
              前往 {provider.name} 官网{provider.promoCode ? `（优惠码 ${provider.promoCode}）` : ''}
            </Button>
          </div>
        )}
      </div>

      <DataProvenance />
      <SourceRecords sources={provider.sources} />
      <RelatedProviders currentProvider={provider} />
      <AffiliateDisclosure />
    </main>
    <SiteFooter />
  </body>
</html>

<style>
  .provider-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--spacing-8);
    flex-wrap: wrap;
    gap: var(--spacing-6);
    background: var(--color-surface);
    padding: var(--spacing-6);
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-border);
    box-shadow: var(--shadow-sm);
  }
  .provider-identity {
    display: flex;
    align-items: center;
    gap: var(--spacing-6);
  }
  .identity-text h1 {
    margin: 0 0 var(--spacing-2) 0;
    font-size: var(--text-3xl);
    font-weight: var(--font-weight-bold);
  }
  .badges {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--spacing-3);
  }
  .updated {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }
  .badge.pick {
    background-color: var(--color-primary-soft);
    color: var(--color-primary);
    padding: 2px 10px;
    border-radius: var(--radius-full);
    font-size: var(--text-xs);
    font-weight: var(--font-weight-semibold);
  }
  .header-actions {
    display: flex;
    align-items: center;
    gap: var(--spacing-4);
  }
  .promo-container {
    min-width: 200px;
  }
  .section {
    margin: var(--spacing-12) 0;
  }
  .section h2 {
    margin-bottom: var(--spacing-6);
    font-size: var(--text-xl);
    color: var(--color-text-main);
  }
  .bottom-cta {
    display: flex;
    justify-content: center;
    margin: var(--spacing-12) 0;
  }
  :global(.btn-large) {
    padding: var(--spacing-4) var(--spacing-8) !important;
    font-size: var(--text-lg) !important;
  }
  :global(.custom-editorial) {
    margin: var(--spacing-8) 0;
  }
  :global(.custom-editorial h2) {
    margin-top: var(--spacing-8);
    margin-bottom: var(--spacing-4);
    font-size: var(--text-2xl);
    color: var(--color-text-main);
  }
  :global(.custom-editorial h2:first-child) {
    margin-top: 0;
  }
  :global(.custom-editorial h3) {
    margin-top: var(--spacing-6);
    margin-bottom: var(--spacing-3);
    font-size: var(--text-xl);
    color: var(--color-text-main);
  }
  :global(.custom-editorial h3:first-child) {
    margin-top: 0;
  }
  :global(.custom-editorial p) {
    color: var(--color-text-secondary);
    font-size: var(--text-base);
    line-height: var(--line-height-loose);
    margin-bottom: var(--spacing-5);
  }
  :global(.custom-editorial ul) {
    padding-left: 1.3em;
    margin-bottom: var(--spacing-5);
  }
  :global(.custom-editorial li) {
    color: var(--color-text-secondary);
    line-height: 1.8;
    margin-bottom: var(--spacing-2);
  }
  :global(.custom-editorial code) {
    background: var(--color-surface);
    padding: 2px 6px;
    border-radius: 4px;
    color: var(--color-primary);
  }
  :global(.custom-editorial a) {
    color: var(--color-primary);
    text-decoration: underline;
  }
  @media (max-width: 768px) {
    .provider-header {
      flex-direction: column;
      align-items: flex-start;
    }
    .header-actions {
      width: 100%;
      flex-direction: column;
      align-items: stretch;
    }
    .promo-container {
      width: 100%;
    }
  }
</style>
