---
import { providers } from '../../data/providers';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import BaseHead from '../../components/BaseHead.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ProviderSpecs from '../../components/ProviderSpecs.astro';
import PlanTable from '../../components/PlanTable.astro';
import EditorialNotes from '../../components/EditorialNotes.astro';
import AffiliateDisclosure from '../../components/AffiliateDisclosure.astro';
import DataProvenance from '../../components/DataProvenance.astro';
import SourceRecords from '../../components/SourceRecords.astro';
import RelatedProviders from '../../components/RelatedProviders.astro';
import EvidenceBadge from '../../components/EvidenceBadge.astro';
import ProviderLogo from '../../components/ProviderLogo.astro';
import PromoCode from '../../components/PromoCode.astro';
import Button from '../../components/Button.astro';
import { customContent } from '../../data/customContent';
import '../../styles/global.css';

export async function getStaticPaths() {
  return providers.map(provider => ({
    params: { slug: provider.slug },
    props: { provider },
  }));
}

const { provider } = Astro.props;
const custom = customContent[provider.slug];
const title = custom ? custom.title : `${provider.name}怎么样？2026套餐价格、流量与线路资料`;
const description = custom ? custom.desc : `${provider.name}机场资料库。官方最低价格 ¥${provider.entryPrice}，提供 ${provider.plans.length} 个套餐，包含线路类型、不限时、流媒体及AI解锁官方声明。`;
const h1Text = custom ? custom.h1 : provider.name;
---

<html lang="zh-CN">
  <head>
    <BaseHead title={title} description={description} canonicalPath={`/airport/${provider.slug}/`} />
  </head>
  <body>
    <SiteHeader />
    <main class="container">
      <Breadcrumbs paths={[
        { label: '机场数据库', url: '/airports/' },
        { label: provider.name, url: `/airport/${provider.slug}/` }
      ]} />
      
      <header class="provider-header">
        <div class="provider-identity">
          <ProviderLogo name={provider.name} logo={provider.logo} size="lg" />
          <div class="identity-text">
            <h1>{h1Text}</h1>
            <div class="badges">
              {provider.editorialPick && <span class="badge pick">编辑推荐 #{provider.editorialRank}</span>}
              <EvidenceBadge type="source" label="官方数据源" />
            </div>
          </div>
        </div>
        
        <div class="header-actions">
          {provider.promoCode && (
            <div class="promo-container">
              <PromoCode code={provider.promoCode} />
            </div>
          )}
          {provider.affiliateUrl && (
            <Button variant="primary" href={provider.affiliateUrl} target="_blank" rel="nofollow sponsored noopener">
              访问官网
            </Button>
          )}
        </div>
      </header>

      <ProviderSpecs provider={provider} />
      
      {custom && custom.html_top && (
        <div class="reading-container custom-content-top" set:html={custom.html_top} />
      )}

      <section class="section section-plans">
        <h2>套餐结构与价格</h2>
        <PlanTable plans={provider.plans} />
      </section>

      <div class="reading-container">
        {custom ? (
          <div class="custom-content-wrapper" set:html={custom.html} />
        ) : (
          <EditorialNotes provider={provider} />
        )}
        
        {provider.affiliateUrl && (
          <div class="bottom-cta">
            <Button variant="primary" href={provider.affiliateUrl} target="_blank" rel="nofollow sponsored noopener" class="btn-large">
              前往 {provider.name} 官网查看详情
            </Button>
          </div>
        )}
      </div>

      <DataProvenance />
      <SourceRecords sources={provider.sources} />
      <RelatedProviders currentProvider={provider} />
      <AffiliateDisclosure />
    </main>
    <SiteFooter />
  </body>
</html>

<style>
  .provider-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--spacing-8);
    flex-wrap: wrap;
    gap: var(--spacing-6);
    background: var(--color-surface);
    padding: var(--spacing-6);
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-border);
    box-shadow: var(--shadow-sm);
  }
  .provider-identity {
    display: flex;
    align-items: center;
    gap: var(--spacing-6);
  }
  .identity-text h1 {
    margin: 0 0 var(--spacing-2) 0;
    font-size: var(--text-3xl);
    font-weight: var(--font-weight-bold);
  }
  .badges {
    display: flex;
    gap: var(--spacing-3);
  }
  .badge.pick {
    background-color: var(--color-primary-soft);
    color: var(--color-primary);
    padding: 2px 10px;
    border-radius: var(--radius-full);
    font-size: var(--text-xs);
    font-weight: var(--font-weight-semibold);
  }
  .header-actions {
    display: flex;
    align-items: center;
    gap: var(--spacing-4);
  }
  .promo-container {
    min-width: 200px;
  }
  .section {
    margin: var(--spacing-12) 0;
  }
  .section h2 {
    margin-bottom: var(--spacing-6);
    font-size: var(--text-xl);
    color: var(--color-text-main);
  }
  .bottom-cta {
    display: flex;
    justify-content: center;
    margin: var(--spacing-12) 0;
  }
  :global(.btn-large) {
    padding: var(--spacing-4) var(--spacing-8) !important;
    font-size: var(--text-lg) !important;
  }
  :global(.custom-editorial) {
    margin: var(--spacing-8) 0;
  }
  :global(.custom-editorial h2) {
    margin-top: var(--spacing-8);
    margin-bottom: var(--spacing-4);
    font-size: var(--text-2xl);
    color: var(--color-text-main);
  }
  :global(.custom-editorial h2:first-child) {
    margin-top: 0;
  }
  :global(.custom-editorial h3) {
    margin-top: var(--spacing-6);
    margin-bottom: var(--spacing-3);
    font-size: var(--text-xl);
    color: var(--color-text-main);
  }
  :global(.custom-editorial h3:first-child) {
    margin-top: 0;
  }
  :global(.custom-editorial p) {
    color: var(--color-text-secondary);
    font-size: var(--text-base);
    line-height: var(--line-height-loose);
    margin-bottom: var(--spacing-5);
  }
  :global(.custom-editorial a) {
    color: var(--color-primary);
    text-decoration: underline;
  }
  @media (max-width: 768px) {
    .provider-header {
      flex-direction: column;
      align-items: flex-start;
    }
    .header-actions {
      width: 100%;
      flex-direction: column;
      align-items: stretch;
    }
    .promo-container {
      width: 100%;
    }
  }
</style>
