---
import { providers } from '../../data/providers';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import BaseHead from '../../components/BaseHead.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ProviderSpecs from '../../components/ProviderSpecs.astro';
import PlanTable from '../../components/PlanTable.astro';
import EditorialNotes from '../../components/EditorialNotes.astro';
import AffiliateDisclosure from '../../components/AffiliateDisclosure.astro';
import DataProvenance from '../../components/DataProvenance.astro';
import RelatedProviders from '../../components/RelatedProviders.astro';
import EvidenceBadge from '../../components/EvidenceBadge.astro';
import { customContent } from '../../data/customContent';
import '../../styles/global.css';

export async function getStaticPaths() {
  return providers.map(provider => ({
    params: { slug: provider.slug },
    props: { provider },
  }));
}

const { provider } = Astro.props;
const custom = customContent[provider.slug];
const title = custom ? custom.title : `${provider.name}怎么样？2026套餐价格、流量与线路资料`;
const description = custom ? custom.desc : `${provider.name}机场资料库。官方最低价格 ¥${provider.entryPrice}，提供 ${provider.plans.length} 个套餐，包含线路类型、不限时、流媒体及AI解锁官方声明。`;
const h1Text = custom ? custom.h1 : provider.name;
---

<html lang="zh-CN">
  <head>
    <BaseHead title={title} description={description} canonicalPath={`/airport/${provider.slug}/`} />
  </head>
  <body>
    <SiteHeader />
    <main class="container">
      <Breadcrumbs paths={[
        { label: '机场数据库', url: '/airports/' },
        { label: provider.name, url: `/airport/${provider.slug}/` }
      ]} />
      
      <header class="provider-header">
        <div class="provider-identity">
          <h1>{h1Text}</h1>
          <div class="badges">
            {provider.editorialPick && <span class="badge pick">Editor's Pick #{provider.editorialRank}</span>}
            <EvidenceBadge type="source" label="官方数据源" />
          </div>
        </div>
        
        {provider.affiliateUrl && (
          <a href={provider.affiliateUrl} target="_blank" rel="nofollow sponsored noopener" class="btn btn-primary">
            访问官网
          </a>
        )}
      </header>

      <AffiliateDisclosure />
      <ProviderSpecs provider={provider} />
      
      <section class="section">
        <h2>套餐结构与价格</h2>
        <PlanTable plans={provider.plans} />
      </section>

      {custom ? (
        <div class="custom-content-wrapper" set:html={custom.html} />
      ) : (
        <EditorialNotes provider={provider} />
      )}
      
      {provider.affiliateUrl && (
        <div class="bottom-cta">
          <a href={provider.affiliateUrl} target="_blank" rel="nofollow sponsored noopener" class="btn btn-primary btn-large">
            前往 {provider.name} 官网查看详情
          </a>
        </div>
      )}

      <DataProvenance />
      <RelatedProviders currentProvider={provider} />
    </main>
    <SiteFooter />
  </body>
</html>

<style>
  .provider-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--spacing-6);
    flex-wrap: wrap;
    gap: var(--spacing-4);
  }
  .provider-identity h1 {
    margin: 0 0 var(--spacing-2) 0;
    font-size: 2.5rem;
  }
  .badges {
    display: flex;
    gap: var(--spacing-2);
  }
  .badge.pick {
    background-color: var(--color-primary);
    color: white;
    padding: 2px 8px;
    border-radius: var(--radius-sm);
    font-size: 0.75rem;
    font-weight: 600;
  }
  .section {
    margin: var(--spacing-8) 0;
  }
  .section h2 {
    margin-bottom: var(--spacing-4);
  }
  .bottom-cta {
    display: flex;
    justify-content: center;
    margin: var(--spacing-8) 0;
  }
  .btn-large {
    padding: var(--spacing-3) var(--spacing-6);
    font-size: 1.1rem;
  }
  :global(.custom-editorial) {
    margin: var(--spacing-8) 0;
  }
  :global(.custom-editorial h3) {
    margin-top: var(--spacing-6);
    margin-bottom: var(--spacing-3);
    font-size: 1.25rem;
    color: var(--color-text);
  }
  :global(.custom-editorial h3:first-child) {
    margin-top: 0;
  }
  :global(.custom-editorial p) {
    color: var(--color-text-muted);
    font-size: 1rem;
    line-height: 1.7;
    margin-bottom: var(--spacing-4);
  }
  :global(.custom-editorial a) {
    color: var(--color-primary);
    text-decoration: underline;
  }
</style>
