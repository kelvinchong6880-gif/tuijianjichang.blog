---
import { providers } from '../../data/providers';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import DataSummary from '../../components/DataSummary.astro';
import ProviderGrid from '../../components/ProviderGrid.astro';
import ProviderFilter from '../../components/ProviderFilter.astro';
import BaseHead from '../../components/BaseHead.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import DataProvenance from '../../components/DataProvenance.astro';
import '../../styles/global.css';
import { UPDATED_MONTH } from '../../data/site';

const planCount = providers.reduce((acc, p) => acc + p.plans.length, 0);
const title = `2026机场大全：${providers.length}家机场套餐价格、线路与优惠码汇总`;
const description = `机场大全（${UPDATED_MONTH}更新）：收录${providers.length}家机场${planCount}个套餐，可按价格、流量、IPLC/IEPL专线、不限时套餐、流媒体与ChatGPT解锁筛选，点击进入每家机场的详细评测。`;
---

<html lang="zh-CN">
  <head>
    <BaseHead title={title} description={description} canonicalPath="/airports/" />
  </head>
  <body>
    <SiteHeader />
    <main id="main" class="container">
      <Breadcrumbs paths={[{ label: '机场大全', url: '/airports/' }]} />
      
      <header class="page-header">
        <h1>机场大全：{providers.length} 家机场套餐与评测汇总</h1>
        <p>按价格、流量、线路和解锁需求筛选全部机场。不想自己比？直接看 <a href="/">机场推荐</a> 或 <a href="/recommend/">Top 8 机场排行榜</a>。</p>
      </header>

      <DataSummary 
        providerCount={providers.length} 
        planCount={planCount} 
        pickCount={providers.filter(p => p.editorialPick).length} 
        lastVerified={UPDATED_MONTH}
      />
      <ProviderFilter />
      <ProviderGrid providers={providers} featuredSlug="sogo-yun" />
      <DataProvenance />
    </main>
    <SiteFooter />
  </body>
</html>

<style>
  .page-header {
    margin-bottom: var(--spacing-8);
  }
  .page-header h1 {
    font-size: 2.25rem;
    margin-bottom: var(--spacing-2);
  }
  .page-header p {
    color: var(--color-text-muted);
    font-size: 1.1rem;
  }
</style>
