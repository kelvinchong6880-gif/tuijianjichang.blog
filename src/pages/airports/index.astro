---
import { providers } from '../../data/providers';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import DataSummary from '../../components/DataSummary.astro';
import ProviderGrid from '../../components/ProviderGrid.astro';
import ProviderFilter from '../../components/ProviderFilter.astro';
import BaseHead from '../../components/BaseHead.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import DataProvenance from '../../components/DataProvenance.astro';
import '../../styles/global.css';

const title = '2026机场大全：22家机场套餐价格与线路参数数据库';
const planCount = providers.reduce((acc, p) => acc + p.plans.length, 0);
const description = `收录22家机场与${planCount}个套餐资料，可查看价格、流量、IPLC、IEPL、不限时套餐、流媒体与AI相关官方声明，并进入各机场数据详情页。`;
---

<html lang="zh-CN">
  <head>
    <BaseHead title={title} description={description} canonicalPath="/airports/" />
  </head>
  <body>
    <SiteHeader />
    <main class="container">
      <Breadcrumbs paths={[{ label: '机场数据库', url: '/airports/' }]} />
      
      <header class="page-header">
        <h1>22家机场资料与套餐数据库</h1>
        <p>提供基于官方客观资料的筛选，全站不包含虚构测速或跑分。</p>
      </header>

      <DataSummary 
        providerCount={providers.length} 
        planCount={planCount} 
        pickCount={providers.filter(p => p.editorialPick).length} 
        lastVerified="2026年9月"
      />
      <ProviderFilter />
      <ProviderGrid providers={providers} featuredSlug="sogo-yun" />
      <DataProvenance />
    </main>
    <SiteFooter />
  </body>
</html>

<style>
  .page-header {
    margin-bottom: var(--spacing-8);
  }
  .page-header h1 {
    font-size: 2.25rem;
    margin-bottom: var(--spacing-2);
  }
  .page-header p {
    color: var(--color-text-muted);
    font-size: 1.1rem;
  }
</style>
